# Two CPU MoE room bots, one per NUMA node (owner decision 2026-11-02):
# Owner 2026-11-03 12:08: Flint Q4_K_M on both nodes, one instance per socket
# (NUMA0 Flint 2, NUMA1 Flint). Qwen3.8 IQ4_XS and Flint Q8_0 GGUFs stay on disk.
# Every bot has VM + tools (#269); long answers continue on
# finish_reason=length until the model stops (see magroom.cpp long_reply_model).
MAG_ROOM_MODEL_ID=flint-numa0
MAG_ROOM_MODEL_LABEL="Flint 2 + Flint"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=off
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=flint-numa0
MAG_ROOM_MODEL_LABEL_0="Flint 2"
MAG_ROOM_MODEL_ID_1=flint
MAG_ROOM_MODEL_LABEL_1="Flint"
