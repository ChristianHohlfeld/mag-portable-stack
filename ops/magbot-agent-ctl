#!/usr/bin/env bash
set -euo pipefail
if [[ $# == 1 && $1 == preflight ]]; then
  exec /usr/local/bin/magbot preflight
fi
[[ $# == 2 && ($1 == spawn || $1 == despawn || $1 == audit-proxy) && $2 =~ ^agent[0-9]+$ ]] || { echo 'Invalid lifecycle invocation' >&2; exit 64; }
exec /usr/local/bin/magbot "$1" "$2"
