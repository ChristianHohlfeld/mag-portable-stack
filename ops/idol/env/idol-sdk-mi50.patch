--- a/idol/models/layers.py
+++ b/idol/models/layers.py
@@ -12,13 +12,31 @@ from torch.nn.attention import SDPBackend, sdpa_kernel
 # Override with ATTN_BACKEND=flash_attn|sdpa|sdpa_cudnn (sdpa_cudnn: PyTorch SDPA restricted to the cuDNN kernel,
 # which IdolPipeline(optimize=True) selects for the denoiser while sampling).
 ATTN_BACKEND = os.environ.get('ATTN_BACKEND',
-                              'flash_attn' if importlib.util.find_spec('flash_attn') is not None else 'sdpa')
+                              'flash_attn' if importlib.util.find_spec('flash_attn') is not None and torch.version.hip is None else 'sdpa')  # MI50 patch
 if ATTN_BACKEND not in ('flash_attn', 'sdpa', 'sdpa_cudnn'):
     raise ValueError(f'Unknown attention backend: {ATTN_BACKEND}')
 if ATTN_BACKEND == 'flash_attn':
     import flash_attn
 
 
+CHUNK_BYTES = int(float(os.environ.get('IDOL_ATTN_CHUNK_MB', '256')) * 2**20)  # MI50 patch
+
+
+def _chunked_attention(q, k, v):
+    """q [N, H, L, C], k/v [N, H, S, C] -> [N, H, L, C]; exact attention, scores built for a block of queries at a time."""
+    n, h, l, c = q.shape
+    s_len = k.shape[2]
+    step = max(64, CHUNK_BYTES // max(1, n * h * s_len * 4))
+    scale = c ** -0.5
+    kt = k.transpose(-1, -2)
+    out = torch.empty_like(q)
+    for i in range(0, l, step):
+        scores = torch.matmul(q[:, :, i:i + step] * scale, kt).float()
+        out[:, :, i:i + step] = torch.matmul(scores.softmax(-1).to(v.dtype), v)
+        del scores
+    return out
+
+
 def scaled_dot_product_attention(*args) -> torch.Tensor:
     """(qkv [N, L, 3, H, C]) or (q [N, L, H, C], k [N, S, H, C], v [N, S, H, C]) -> [N, L, H, C]."""
     if ATTN_BACKEND == 'flash_attn':
@@ -30,6 +48,8 @@ def scaled_dot_product_attention(*args) -> torch.Tensor:
     if ATTN_BACKEND == 'sdpa_cudnn':
         with sdpa_kernel(SDPBackend.CUDNN_ATTENTION):
             out = F.scaled_dot_product_attention(q, k, v)
+    elif torch.version.hip is not None and q.is_cuda and os.environ.get('IDOL_CHUNKED_ATTN', '1') == '1':
+        out = _chunked_attention(q, k, v)  # MI50 patch
     else:
         out = F.scaled_dot_product_attention(q, k, v)
     return out.permute(0, 2, 1, 3)
