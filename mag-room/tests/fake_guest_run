#!/usr/bin/env bash
# Stand-in for magbot-guest-run in the room tests: the "VM" is a temp dir on
# this machine. Same argument grammar and the same 0x1e control records.
set -uo pipefail
vm=${1:?}; shift
home="${FAKE_GUEST_HOME:-/tmp}/$vm"; mkdir -p "$home"
case "${1:-}" in
  --stdin)
    script=$(mktemp); cat > "$script"
    trap 'kill -TERM -- -$child 2>/dev/null; printf "\x1ecancelled\n"; rm -f "$script"; exit 130' TERM
    (cd "$home" && HOME="$home" exec setsid bash "$script" 2>&1) &
    child=$!
    wait "$child"; rc=$?
    rm -f "$script"
    printf '\x1elog %s/.mag-shell/test.log 0\n' "$home"
    exit "$rc" ;;
  --watch)
    # The same listing as magbot watch, over the temp dir.
    code=$(cat <<'PY'
import base64, json, os, stat, sys
home, what = sys.argv[1], sys.argv[2]
if what == 'list':
    out = {}
    for root, dirs, files in os.walk(home):
        rel = os.path.relpath(root, home)
        rel = '' if rel == '.' else rel + '/'
        dirs[:] = [d for d in dirs if d not in ('.mag-shell', 'room', 'browserd')]
        for name in files:
            st = os.lstat(os.path.join(root, name))
            out[rel + name] = [st.st_size, str(st.st_mtime_ns)]
    print(json.dumps({'files': out, 'cut': False}))
else:
    got = {}
    for r in sys.stdin.read().split('\n'):
        if r and os.path.isfile(os.path.join(home, r)):
            got[r] = base64.b64encode(open(os.path.join(home, r), 'rb').read(65537)).decode()
    print(json.dumps(got))
PY
)
    exec python3 -c "$code" "$home" "$2"
    ;;
  --write|--append)
    target=$2; [[ $target == /* ]] || target="$home/$target"
    mkdir -p "$(dirname "$target")"
    if [[ $1 == --append ]]; then cat >> "$target"; else cat > "$target"; fi
    echo "saved $target $(stat -c %s "$target") bytes" ;;
  *) echo 'Invalid guest invocation' >&2; exit 64 ;;
esac
