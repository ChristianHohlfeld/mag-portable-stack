[Unit]
Description=MAG Raum - gpt-oss-120b group chat with VM-backed bots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magbot
Group=magbot
WorkingDirectory=/opt/magbot
EnvironmentFile=-/etc/default/mag-room
ExecStart=/usr/bin/python3 -u /opt/magbot/app.py
Restart=always
RestartSec=3
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
