# Copy to /etc/mag-backup/aws.env, chmod 0600, chown root:root.
# This file alone does NOT activate S3. Also set
# MAG_BACKUP_OFFSITE_ENABLED=1 in /etc/mag-backup/config.env after explicit approval.
# Otherwise offsite stays disabled even with this file present.
AWS_ACCESS_KEY_ID=REPLACE_ON_HOST
AWS_SECRET_ACCESS_KEY=REPLACE_ON_HOST
AWS_DEFAULT_REGION=eu-central-1
