From 25f1cfec1b5414258b48f07f67447e09cdc89e50 Mon Sep 17 00:00:00 2001
From: mag <mag@localhost>
Date: Fri, 16 Oct 2026 11:43:18 +0200
Subject: [PATCH] mag: software prefetch in the AVX2 Q8_0_R8 and MXFP4_R8 GEMV
 kernels (GGML_Q8_PF, GGML_MXFP4_PF)

Batch-1 decode streams every weight row once per token; the 145 GB model never fits in L3 and
Broadwell's L2 streamer stops at each 4 KiB page boundary. Prefetch the R8 blocks a fixed
distance ahead of the one being read: block_q8_0_r8 (272 B, 5 lines) in mul_mat_q8_0_r8_q8_2_avx2,
block_mxfp4_r8 (136 B, 3 lines) in mul_mat_mxfp4_r8_q8_2_avx2 (all nrc_y).
Distance in bytes, default 4096, read once from GGML_Q8_PF / GGML_MXFP4_PF (0 = off).
No change to the arithmetic, results are bit-identical.
---
 ggml/src/iqk/iqk_gemm_legacy_quants.cpp | 26 +++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/ggml/src/iqk/iqk_gemm_legacy_quants.cpp b/ggml/src/iqk/iqk_gemm_legacy_quants.cpp
index a32acd4..6db6a1b 100644
--- a/ggml/src/iqk/iqk_gemm_legacy_quants.cpp
+++ b/ggml/src/iqk/iqk_gemm_legacy_quants.cpp
@@ -1,6 +1,7 @@
 #include "iqk_gemm_legacy_quants.h"
 
 #include <type_traits>
+#include <cstdlib>
 
 #ifdef IQK_IMPLEMENT
 
@@ -1210,6 +1211,26 @@ static void mul_mat_q4_0_r8_q8_2(int n, const void * vx, size_t bx, const DataIn
 }
 #endif
 
+// mag: software prefetch for the weight rows streamed at batch 1. A 145 GB model never fits in L3, and on
+// Broadwell the L2 streamer stops at every 4 KiB page boundary, so each core stalls on demand misses there.
+// Distance in bytes ahead of the block being read; GGML_Q8_PF / GGML_MXFP4_PF override (0 = off), read once.
+static inline int mag_pf_env(const char * name) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : 4096;
+}
+static inline int mag_q8_pf()    { static const int d = mag_pf_env("GGML_Q8_PF");    return d; }
+static inline int mag_mxfp4_pf() { static const int d = mag_pf_env("GGML_MXFP4_PF"); return d; }
+template <int NLINES>
+static inline void mag_prefetch(const void * p, int dist) {
+    if (dist > 0) {
+        const char * c = (const char *) p + dist;
+        for (int i = 0; i < NLINES; ++i) {
+            _mm_prefetch(c + 64*i, _MM_HINT_T0);   // prefetch never faults, also past the end of the buffer
+        }
+    }
+}
+// block_mxfp4_r8 = 8 + 128 B -> 3 lines, block_q8_0_r8 = 16 + 256 B -> 5 lines
+
 inline void prepare_mxfp4_quants_avx2(const uint8_t * qs, __m256i * v, const __m256i& m4, const __m256i & table) {
     auto bits1 = _mm256_loadu_si256((const __m256i *)qs+0);
     auto bits2 = _mm256_loadu_si256((const __m256i *)qs+1);
@@ -1271,6 +1292,7 @@ static void mul_mat_mxfp4_r8_q8_2_avx2(int n, const void * vx, size_t bx, const
     auto table = MM256_SET1_M128I(table128);
     table = _mm256_add_epi8(table, _mm256_set1_epi8(12));
     __m256i v[8];
+    const int pf = mag_mxfp4_pf();
     if constexpr (nrc_y == 1) {
         union { __m256 vec; float val[8]; } helper;
         for (int ix = 0; ix < nrc_x; ix += 8) {
@@ -1280,6 +1302,7 @@ static void mul_mat_mxfp4_r8_q8_2_avx2(int n, const void * vx, size_t bx, const
             for (int ib4 = 0; ib4 < nb/4; ++ib4) {
                 helper.vec = convert_scales((const uint16_t *)q8.y[0][ib4].d);
                 for (int k = 0; k < 4; ++k) {
+                    mag_prefetch<3>(iq4 + 4*ib4 + k, pf);
                     auto scales = convert_mxfp4_scales(iq4[4*ib4+k].e);
                     prepare_mxfp4_quants_avx2(iq4[4*ib4+k].qs, v, m4, table);
                     auto sumi = accum_mxfp4_quants(v, q8.y[0][ib4].qs+32*k);
@@ -1326,6 +1349,7 @@ static void mul_mat_mxfp4_r8_q8_2_avx2(int n, const void * vx, size_t bx, const
                     }
                 }
                 for (int k = 0; k < 4; ++k) {
+                    mag_prefetch<3>(iq4 + 4*ib4 + k, pf);
                     //auto scales = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *)iq4[4*ib4+k].d));
                     prepare_mxfp4_quants_avx2(iq4[4*ib4+k].qs, v, m4, table);
                     for (int iy = 0; iy < nrc_y; ++iy) {
@@ -1791,6 +1815,7 @@ static inline void mul_mat_q8_0_r8_q8_2_avx2(int n, const void * vx, size_t bx,
     Q8<nrc_y, block_q8_2_x4> q8(info);
     auto m1 = _mm256_set1_epi16(1);
     int nb = n / QK8_0;
+    const int pf = mag_q8_pf();
     __m256 acc[nrc_y] = {};
     float d8[4*nrc_y];
     __m256i qx[4], sx[4];
@@ -1824,6 +1849,7 @@ static inline void mul_mat_q8_0_r8_q8_2_avx2(int n, const void * vx, size_t bx,
                 _mm_storeu_ps(d8 + 4*iy, scales);
             }
             for (int k = 0; k < 4; ++k) {
+                mag_prefetch<5>(iq8 + 4*ib4 + k, pf);
                 auto scales = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *)iq8[4*ib4+k].d));
                 __m256i sumi_first[nrc_y];
                 for (int j = 0; j < 4; ++j) {
