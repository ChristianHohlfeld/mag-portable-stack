# MAG Local LLM – DeepSeek-V4-Flash-0731 (unsloth UD-Q4_K_XL, ~144 GiB) via llama.cpp, CPU-only.
# VORLAGE: @LOAD_ARGS@ setzt ops/deepseek/render-llm-unit.sh passend zum llama-Build ein
# (Laden ohne mmap, mit mlock). Installiert durch ops/deepseek/upgrade-3.5.sh / install-deepseek.sh.
#
# - Lauscht NUR intern auf 127.0.0.1:8090. Raum, Grok und Ali sprechen mit :8080 = mag-audit-gateway,
#   das jeden Aufruf vollständig protokolliert; :8090 ist per nftables nur für root/mag-audit offen.
# - Startet erst nach bestandener SHA-256-Vollprüfung (mag-model-gate, Freigabe-Stempel).
# - Speicher: Gewichte liegen im eigenen Prozessspeicher (kein mmap) -> llama kann sie für AVX2
#   umsortieren. Gesperrt (mlock) und nie ausgelagert (MemorySwapMax=0). Die beim Laden entstandenen
#   Page-Cache-Seiten gibt mag-llm-postload danach frei -> keine zweite Kopie im RAM.
# - NUMA: numactl --interleave=all verteilt die Gewichte gleichmäßig auf beide Sockel,
#   --numa distribute die Threads (gemessen auf mag: Generierung +31 % gegenüber vorher).
# - Threads: 28 = physische Kerne. Hyperthreads teilen sich die AVX2-Einheiten und die Bandbreite.
# - Batch: 2048/2048 – größere Mikro-Batches lassen jeden MoE-Experten mehr Tokens pro Durchgang
#   rechnen (Prompt-Lesen); die Generierung betrifft das nicht.
# Basis auf mag vor 3.5 (mmap+mlock, t28/tb28, b/ub 1024, interleave; http-bench 16.10.):
#   Prompt 19-22 t/s, Generierung 3,3-3,6 t/s, Prompt-Cache-Treffer 0,5 s statt 155 s (3.331 Tokens).
# Gewollter Neustart (lädt ~144 GiB neu, einige Minuten):  sudo bash ops/deepseek/warm.sh restart-llm
[Unit]
Description=MAG Local LLM - DeepSeek-V4-Flash-0731 via ik_llama.cpp (CPU)
After=network-online.target mag-audit-nft.service
Wants=network-online.target
ConditionPathExists=/var/lib/mag-llm/verified.stamp
RefuseManualStop=yes

[Service]
# ik_llama.cpp (ab 3.8, erzeugt von ops/deepseek/render-ik-unit.sh) – mag-Varianten:
Environment=MAG_NUMA_LOCAL=16
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris

ExecStartPre=/usr/local/lib/mag-deepseek/model-gate.sh check-stamp
ExecStartPre=/usr/bin/test -r /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja

ExecStart=/usr/bin/numactl --interleave=all /home/chris/.local/ik/8d21687cc7-mag-abe5bad6/bin/llama-server \
  --model /home/chris/models/deepseek-v4/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf \
  --alias deepseek-v4-flash-0731 \
  --host 127.0.0.1 \
  --port 8090 \
  --ctx-size 32768 \
  --parallel 1 \
  --threads 16 \
  --threads-batch 28 \
  --numa distribute \
  --batch-size 1024 \
  --ubatch-size 1024 \
  --mlock \
  --flash-attn on \
  --cache-type-k f16 \
  --cache-type-v f16 \
  --cache-ram 16384 \
  --jinja \
  --chat-template-file /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja \
  --reasoning-format deepseek \
  --temp 1.0 \
  --top-p 0.95 \
  --min-p 0.01 \
  --metrics \
  --webui none \
  -rtr

# Nach dem Laden die Page-Cache-Kopie der Modelldateien freigeben (eigene transiente Unit, blockiert nichts)
# ("-": ein Fehler hier darf den Start von llama nie verhindern)
ExecStartPost=-+/usr/bin/systemd-run --no-block --collect --quiet --description=mag-llm-postload \
  --property=Nice=10 /usr/local/lib/mag-deepseek/post-load.sh

# immer wieder hochkommen (auch nach sauberem Ende); manuelles Stoppen ist gesperrt (RefuseManualStop)
Restart=always
RestartSec=10
TimeoutStopSec=120

MemorySwapMax=0
MemoryLow=180G
OOMScoreAdjust=-1000
# systemd-oomd darf diese Unit nie als Opfer wählen
ManagedOOMPreference=omit
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
