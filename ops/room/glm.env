# Shared by magroom and mag-audit-gateway. port:NUMA, NOT port:llama-slot.
# Layout "glm": DeepSeek on NUMA0, GLM-5.3-Flash on NUMA1 (Qwen retired from
# the stack, weights stay on disk; MAG_ROOM_LAYOUT=mixed restores it).
MAG_ROOM_MODEL_ID=deepseek-v4-flash-0731
MAG_ROOM_MODEL_LABEL="DeepSeek V4 Flash + GLM-5.3 Flash"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_THINKING=on
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=deepseek-v4-flash-0731
MAG_ROOM_MODEL_LABEL_0="DeepSeek V4 Flash"
MAG_ROOM_MODEL_ID_1=glm-5.3-flash
MAG_ROOM_MODEL_LABEL_1="GLM-5.3 Flash"
