[Unit]
Description=MAG Idol MI50 image-to-splat queue (optional)
After=network.target
ConditionPathExists=/home/chris/idol-mi50/venv/bin/python
ConditionPathExists=/home/chris/idol-mi50/weights/idol

[Service]
Type=simple
User=chris
Group=chris
SupplementaryGroups=render video
WorkingDirectory=/home/chris/idol-mi50
# Root, lower-only: keeps the MI50 at or below its 78 W cap (never raises it).
ExecStartPre=+/usr/local/lib/mag-idol/power-cap.sh
ExecStart=/usr/bin/python3 -I /opt/mag-stack/current/ops/idol/worker.py
Environment=MAG_IDOL_JOB_ROOT=/var/lib/mag-idol/jobs
Environment=MIOPEN_USER_DB_PATH=/var/lib/mag-idol/miopen
Environment=MIOPEN_CUSTOM_CACHE_DIR=/var/lib/mag-idol/miopen-cache
Environment=MAG_IDOL_PYTHON=/home/chris/idol-mi50/venv/bin/python
Environment=MAG_IDOL_WEIGHTS=/home/chris/idol-mi50/weights/idol
Environment=IDOL_DINOV3=/home/chris/idol-mi50/weights/dinov3-timm
Environment=IDOL_FLUX2_VAE=/home/chris/idol-mi50/weights/flux2vae
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=ATTN_BACKEND=sdpa
Environment=MAG_IDOL_TIMEOUT_S=4200
Environment=PYTHONUNBUFFERED=1
CPUAccounting=yes
AllowedCPUs=28-55
# A video's two experts and its text encoder pass through memory on their way to the card.
MemoryMax=56G
TasksMax=512
Restart=on-failure
RestartSec=5
# A restart or stop of the worker ends the worker only. A stage that is
# running (sampling on the MI50, meshing) goes on in this unit's group and
# the next worker follows it again: a deploy never costs a 3D job.
KillMode=process
NoNewPrivileges=true
# Its own /tmp, but one that stays when the worker restarts: a private tmp
# would be removed under a stage that is still running.
BindPaths=/var/lib/mag-idol/tmp:/tmp /var/lib/mag-idol/tmp:/var/tmp
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mag-idol
DevicePolicy=auto
UMask=0077
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
