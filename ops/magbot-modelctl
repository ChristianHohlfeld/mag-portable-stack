#!/usr/bin/env bash
# Hard stop for the room's model servers (magroom "Bots stoppen"/"Fortsetzen").
# freeze: cgroup freezer (systemctl freeze). The llama processes keep their
#         mlocked weights, KV cache and slot prefixes in RAM but get no CPU.
# thaw:   continues them where they were: no reload, no new prefill.
# Only the room's model units; the independent mag-llm.service is never touched.
set -euo pipefail
[[ $# == 1 && ($1 == freeze || $1 == thaw || $1 == status) ]] || { echo 'usage: magbot-modelctl freeze|thaw|status' >&2; exit 64; }
mapfile -t units < <(systemctl list-units --plain --no-legend --state=active \
  'mag-llm-coding@*.service' 'mag-llm-ds-node@*.service' 'mag-llm-glm@*.service' | awk '{print $1}')
rc=0
for u in "${units[@]}"; do
  [[ $u =~ ^mag-llm-(coding|ds-node|glm)@[A-Za-z0-9_-]+\.service$ ]] || continue
  state=$(systemctl show -p FreezerState --value "$u")
  case $1 in
    freeze) [[ $state == frozen ]] || systemctl freeze "$u" || rc=1 ;;
    thaw)   [[ $state == running ]] || systemctl thaw "$u" || rc=1 ;;
    status) echo "$u $state" ;;
  esac
done
exit $rc
