#!/usr/bin/env bash
set -euo pipefail
magbot=${MAG_BOTS_MAGBOT:-/usr/local/bin/magbot}
site=${MAG_BOTS_SITE:-/usr/local/lib/mag-bots/site.sh}
if [[ $# == 1 && $1 == preflight ]]; then
  exec "$magbot" preflight
fi
# Saves of a bot's VM (magbot save): a save and a restore run as units of
# their own, so a restart of the room does not cut them off; asking while one
# runs is asking once.
if [[ ($# == 2 || $# == 3) && $1 == save && $2 =~ ^agent[0-9]+$ && ${3:-manual} =~ ^(manual|chat|daily)$ ]]; then
  unit="magbot-save-$2"
  systemd-run --quiet --wait --collect --unit "$unit" -p CPUAffinity=28-55 -p Nice=10 -p IOSchedulingClass=idle \
    "$magbot" save "$2" "${3:-manual}" && exit 0
  rc=$?
  journalctl -q -u "$unit" -n 3 -o cat --no-pager 2>/dev/null | tail -n 3 >&2
  exit "$rc"
fi
if [[ $# == 4 && $1 == restore && $2 =~ ^agent[0-9]+$ && $3 =~ ^[0-9]{8}T[0-9]{6}Z-[a-z-]{1,24}$ && $4 =~ ^[a-f0-9]{8,64}$ ]]; then
  unit="magbot-restore-$2"
  systemd-run --quiet --wait --collect --unit "$unit" -p CPUAffinity=28-55 -p Nice=10 \
    "$magbot" restore "$2" "$3" "$4" && exit 0
  rc=$?
  journalctl -q -u "$unit" -n 3 -o cat --no-pager 2>/dev/null | tail -n 3 >&2
  exit "$rc"
fi
if [[ $# == 2 && $1 == saves && $2 =~ ^agent[0-9]+$ ]]; then exec "$magbot" saves "$2"; fi
[[ $# == 2 && ($1 == spawn || $1 == despawn || $1 == reset || $1 == audit-proxy || $1 == ip || $1 == verify) && $2 =~ ^agent[0-9]+$ ]] || { echo 'Invalid lifecycle invocation' >&2; exit 64; }
if [[ $1 == verify ]]; then
  # Native read-only registry check. Exit 3 means missing metadata; any other
  # error must fail closed without detaching or deleting a workspace.
  exec "$magbot" verify "$2"
fi
if [[ $1 == ip ]]; then
  # Host-side lease/agent lookup: faster and more reliable than running
  # 'hostname -I' inside the guest for every browser connection.
  # Verify the target is an owned MAG VM before asking libvirt.
  "$magbot" inspect "$2" >/dev/null
  for source in lease agent; do
    addresses=$(/usr/bin/timeout 6 /usr/bin/virsh -c qemu:///system domifaddr "magbot-$2" --source "$source" 2>/dev/null || true)
    ip=$(awk '$3=="ipv4" {split($4,a,"/"); if(a[1] ~ /^192[.]168[.]122[.]/) {split(a[1],b,"."); if(b[4]>=2 && b[4]<=254) {print a[1];exit}}}' <<<"$addresses")
    if [[ -n $ip ]]; then printf '%s\n' "$ip"; exit 0; fi
  done
  echo "MAG VM DHCP lease and guest-agent address unavailable for $2" >&2
  exit 3
fi
if [[ $1 == spawn ]]; then
  "$magbot" spawn "$2"
  if [[ -x $site ]]; then "$site" assign "$2" || echo "WARN: bot site assign failed for $2" >&2; fi
  exit 0
fi
if [[ $1 == reset ]]; then
  # The owner's reset of one bot: a fresh VM from the golden image under the
  # same name, nothing of the old one kept, and its site empty again.
  "$magbot" reset "$2"
  if [[ -x $site ]]; then "$site" reset "$2" || echo "WARN: bot site reset failed for $2" >&2; fi
  exit 0
fi
if [[ $1 == despawn ]]; then
  "$magbot" despawn "$2"
  if [[ -x $site ]]; then "$site" remove "$2" || echo "WARN: bot site cleanup failed for $2" >&2; fi
  exit 0
fi
exec "$magbot" "$1" "$2"
