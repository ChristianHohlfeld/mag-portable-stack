+        wq.get(), ws.get(), xq.get(), xs.get(), (float *) dst->data, int64_t(dst->nb[1] / sizeof(float)), int(m), int(n), int(k));
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+#endif
+
 static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
     GGML_TENSOR_BINARY_OP_LOCALS
 
@@ -2294,6 +2318,14 @@ static void ggml_cuda_mul_mat(ggml_backend_cuda_context & ctx, const ggml_tensor
         ggml_cuda_mul_mat_vec_q(ctx, src0, src1, nullptr, dst);
         return;
     }
+#if defined(GGML_USE_HIP)
+    // gfx906's own W8A8 GEMM for Q8_0 weights over long token runs (MAG stack).
+    if (cc == GGML_CUDA_CC_VEGA20 && src0->type == GGML_TYPE_Q8_0 && ne11 >= 128 && ne02 == 1 && ne03 == 1 &&
+        ne12 == 1 && ne13 == 1 && ne00 % 32 == 0 && ggml_is_contiguous(src0) && src1->nb[0] == sizeof(float) &&
+        dst->nb[0] == sizeof(float) && ggml_mul_mat_q8_gfx906(ctx, src0, src1, dst)) {
