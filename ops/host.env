# Who and where this MAG host is. These are the values of the reference host
# (mag); a server of its own puts its values into /etc/mag-stack/host.env
# (./install.sh writes that file from ops/install/templates/host.env), which
# overrides these line by line. Not secret. Read by ops/host.sh.
#
# The account that owns the models, the Idol environment and the checkout.
MAG_OWNER=chris
# The room's name (TLS via ACME DNS-01) and the zone of the bots' sites.
MAG_DOMAIN=mag.stardenburg.de
MAG_BOTS_ZONE=bot.stardenburg.de
# The host's Tailscale address and MagicDNS name (Gitea over Funnel).
# Empty: read from tailscale itself (tailscale ip -4, tailscale status).
MAG_TAILNET_IP=
MAG_TS_NAME=
# Contact for Web Push (VAPID subject) and Let's Encrypt.
MAG_CONTACT=mailto:mag@stardenburg.de
