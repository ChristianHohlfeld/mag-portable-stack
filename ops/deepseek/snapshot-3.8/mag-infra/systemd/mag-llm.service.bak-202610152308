[Unit]
Description=MAG Local LLM - GPT-OSS 120B via llama.cpp
After=network-online.target
Wants=network-online.target
#RefuseManualStop=yes

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris

ExecStartPre=/usr/bin/test -r /home/chris/models/gpt-oss-120b/gpt-oss-120b.gguf
ExecStartPre=/usr/bin/test -r /home/chris/llama-templates/openai-gpt-oss-120b.jinja

ExecStart=/home/chris/.local/bin/llama serve \
  -m /home/chris/models/gpt-oss-120b/gpt-oss-120b.gguf \
  --alias gpt-oss:120b \
  --host 127.0.0.1 \
  --port 8080 \
  -c 32768 \
  -np 1 \
  -t 28 \
  -tb 28 \
  --numa distribute \
  --swa-full \
  --cache-ram 8192 \
  --ctx-checkpoints 32 \
  --checkpoint-min-step 8192 \
  -b 1024 \
  -ub 1024 \
  --jinja \
  --chat-template-file /home/chris/llama-templates/openai-gpt-oss-120b.jinja \
  --reasoning-format auto \
  --flash-attn auto \
  --no-webui

Restart=always
RestartSec=2

MemorySwapMax=0
MemoryLow=80G
OOMScoreAdjust=-900

LimitNOFILE=1048576
LimitMEMLOCK=infinity

TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
