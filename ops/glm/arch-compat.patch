diff --git a/src/models/glm5-next.cpp b/src/models/glm5-next.cpp
index 90870bd..7da6136 100644
--- a/src/models/glm5-next.cpp
+++ b/src/models/glm5-next.cpp
@@ -4,6 +4,61 @@
 // GLM5-Next (GLM-5.3-Flash): hybrid KDA (linear) + nope MLA with a k-pool DSA indexer,
 // mHC residual streams, DeepSeek-style MoE.
 
+// Weights consumed by elementwise ops (add/mul, incl. the fused mHC ops) instead
+// of mul_mat. The ggml CPU binary kernels only accept a float src1, but low-bit
+// mixture quantizations may store 2-D ones (e.g. indexer_compressor_ape) as
+// IQ4_NL. Such weights are dequantized in the graph; for F32 files this is a
+// no-op and the graph is unchanged. Validated at load (glm5_check_weight_types).
+static ggml_tensor * glm5_f32(ggml_context * ctx, ggml_tensor * w) {
+    if (w == nullptr || w->type == GGML_TYPE_F32) {
+        return w;
+    }
+    return ggml_cast(ctx, w, GGML_TYPE_F32);
+}
+
+// Fail at load with the tensor name instead of a GGML_ABORT on the first decode.
+//  - cast:   weights passed through glm5_f32(); any type ggml can dequantize is fine
+//  - strict: norm/conv weights used directly by elementwise kernels; must be F32
+static void glm5_check_weight_types(const llama_model & model) {
+    int n_cast = 0;
+    auto cast = [&](const ggml_tensor * t) {
+        if (t == nullptr || t->type == GGML_TYPE_F32) {
+            return;
+        }
+        if (ggml_get_type_traits(t->type)->to_float == nullptr) {
+            throw std::runtime_error(format("glm5-next: %s has type %s, which cannot be dequantized for an elementwise op",
+                    ggml_get_name(t), ggml_type_name(t->type)));
+        }
+        n_cast++;
+    };
+    auto strict = [&](const ggml_tensor * t) {
+        if (t != nullptr && t->type != GGML_TYPE_F32) {
+            throw std::runtime_error(format("glm5-next: %s has type %s; this elementwise weight must be F32 "
+                    "(re-quantize with --tensor-type for this tensor)", ggml_get_name(t), ggml_type_name(t->type)));
+        }
+    };
+    strict(model.output_norm);
+    for (const auto & layer : model.layers) {
+        cast(layer.indexer_kpool_ape);
+        cast(layer.ssm_dt_b);
+        cast(layer.ssm_a);
+        cast(layer.hc_attn_scale);
+        cast(layer.hc_attn_base);
+        cast(layer.hc_ffn_scale);
+        cast(layer.hc_ffn_base);
+        cast(layer.ffn_exp_probs_b);
+        for (const ggml_tensor * t : {layer.attn_norm, layer.ffn_norm, layer.ssm_o_norm,
+                layer.attn_q_a_norm, layer.attn_kv_a_norm, layer.indexer_k_norm, layer.indexer_k_norm_b,
+                layer.ssm_q_conv, layer.ssm_k_conv, layer.ssm_v_conv,
+                layer.nextn.enorm, layer.nextn.hnorm, layer.nextn.shared_head_norm}) {
+            strict(t);
+        }
+    }
+    if (n_cast > 0) {
+        LLAMA_LOG_INFO("%s: %d non-F32 elementwise weights are dequantized to F32 in the graph\n", __func__, n_cast);
+    }
+}
