# Canonical Q4 start values for a fresh /etc/mag-llm/llm.env.
# Bootstrap copies this file only when the host file is absent.
# Never overwrite a live env, and never restart mag-llm to apply it.
# ops/mag-llm.service and ops/deepseek/ik/50-ik.conf are templates.
# The running unit on mag is the rendered ik_llama unit plus the node0 drop-in.
ENGINE=ik
IK_BIN=/home/chris/.local/ik/8d21687cc7-mag-c96826ab/bin/llama-server
THREADS=16
THREADS_BATCH=16
BATCH=1024
UBATCH=1024
NUMA_ARGS="--cpunodebind=0 --membind=0"
LLAMA_NUMA=numactl
IK_RTR=1
IK_SLOT_SAVE=1
IK_SLOT_SAVE_PATH=/var/lib/mag-llm/slots
IK_CRS=0.20
LOAD_ARGS="--load-mode mmap+mlock"
