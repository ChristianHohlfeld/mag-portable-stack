@@ -580,0 +594,37 @@ function traceSection(kind,label,body,count){
+// One row per call (input + output paired), like the tool cards in ChatGPT/Claude.
+const TOOL_KEYS=['query','q','url','command','cmd','path','file','name','repo','title','text','fact','prompt','message'];
+function toolArgPreview(t){
+ const a=t.args;if(!a||typeof a!=='object')return t.args_text||'';
+ for(const k of TOOL_KEYS)if(typeof a[k]==='string'&&a[k].trim())return a[k].trim().replace(/\s+/g,' ');
+ for(const v of Object.values(a))if(typeof v==='string'&&v.trim())return v.trim().replace(/\s+/g,' ');
+ return '';
+}
+function toolInput(t){
+ const a=t.args;if(!a||typeof a!=='object')return t.args_text||'–';
+ const keys=Object.keys(a);if(!keys.length)return '–';
+ if(keys.length===1&&typeof a[keys[0]]==='string')return a[keys[0]];
+ return JSON.stringify(a,null,2);
+}
+function fmtMs(ms){return ms==null?'':ms<1000?Math.max(1,Math.round(ms))+' ms':(ms/1000).toLocaleString('de-DE',{maximumFractionDigits:1})+' s'}
+function toolRow(row,t){
+ const state=t.result==null?'run':t.ok===false?'fail':'ok';
+ if(!row){row=document.createElement('details');row.className='tool-call';row.innerHTML='<summary><span class="tool-dot"></span><span class="tool-name"></span><span class="tool-arg"></span><span class="tool-ms"></span></summary><div class="tool-io"><div class="tool-k">Eingabe</div><pre class="tool-in"></pre><div class="tool-k">Ergebnis</div><pre class="tool-out"></pre></div>'}
+ row.classList.remove('run','ok','fail');row.classList.add(state);
+ row.querySelector('.tool-name').textContent=t.label||t.name||'Werkzeug';
+ const arg=toolArgPreview(t);row.querySelector('.tool-arg').textContent=arg;row.querySelector('.tool-arg').title=arg;
+ row.querySelector('.tool-ms').textContent=state==='run'?'läuft …':(state==='fail'?'Fehler · ':'')+fmtMs(t.ms);
+ row.querySelector('.tool-in').textContent=toolInput(t);
+ row.querySelector('.tool-out').textContent=t.result==null?'Läuft noch …':(t.result.trim()||'(leer)');
+ return row;
+}
+function paintTools(node,content,tools){
+ let box=node.querySelector(':scope > .tools-trace');
+ if(!tools?.length){box?.remove();return}
+ if(!box){box=traceSection('tools-trace','Werkzeuge','','');const body=box.querySelector('.trace-body');body.classList.add('tool-list');body.replaceChildren();content.before(box)}
+ const failed=tools.filter(t=>t.ok===false).length;
+ box.querySelector('.trace-count').textContent=tools.length+(tools.length===1?' Aufruf':' Aufrufe')+(failed?' · '+failed+' fehlgeschlagen':'');
+ const body=box.querySelector('.trace-body');
+ tools.forEach((t,i)=>{const row=body.children[i];const next=toolRow(row,t);if(!row)body.append(next)});
+ while(body.children.length>tools.length)body.lastChild.remove();
+}
+function storedTools(msg){return Array.isArray(msg.tools)?msg.tools.map(t=>({name:t.tool,label:t.label,args:t.args,args_text:t.args_text,result:typeof t.result==='string'?t.result:'',ok:t.ok!==false,ms:t.ms})):[]}
