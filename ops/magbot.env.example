# /etc/magbot/magbot.env - site configuration for magbotctl (ops/magbot).
# Root-owned, sourced by the CLI. Installed once by ops/deploy.sh and never
# overwritten. Contains no secrets.
#
# LLM endpoint the guest is told about (/etc/magbot/llm.env in the VM) and
# that "magbotctl verify" probes from inside the guest. Empty (default) means
# bots reach the model only through the room, which is how all bots work
# today: the room calls the audit gateway 127.0.0.1:8080 on the host, mag-llm
# listens only on 127.0.0.1:8090, Qwen on 127.0.0.1:8091, and the agent
# nftables policy opens no LLM port on virbr0 (192.168.122.1:8091 is the bot
# site publisher, not a model). Set this only together with a matching
# firewall rule; never point it at mag-llm directly.
#MAGBOT_LLM_URL=http://192.168.122.1:PORT/v1
#MAGBOT_VCPUS=2
#MAGBOT_RAM_GIB=4
#MAGBOT_DISK_GIB=20
#MAGBOT_GITEA=none
