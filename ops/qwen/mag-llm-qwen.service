# Installed as a disabled fallback by the Ornith deploy; never auto-started with Ornith.
# Standalone Qwen after Ornith rollback, no DeepSeek/Q4 dependency.
[Unit]
Description=MAG Qwen3.8 Flash Next CPU model, NUMA1
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/mag-qwen/model.sha256
StartLimitIntervalSec=1800
StartLimitBurst=2
[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris
# Backend ports are root/audit-only; preflight must not run under User=chris.
# Standalone Qwen fallback: no DeepSeek / Q4 health gate.
ExecStart=/usr/local/lib/mag-qwen/start.sh
Restart=on-failure
RestartSec=60
TimeoutStartSec=10800
TimeoutStopSec=120
CPUAffinity=42-55
AllowedCPUs=42-55
NUMAPolicy=bind
NUMAMask=1
MemoryAccounting=yes
MemoryHigh=160G
MemoryMax=184G
MemorySwapMax=0
LimitMEMLOCK=infinity
OOMScoreAdjust=-600
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/mag-llm/slots/qwen
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
[Install]
WantedBy=multi-user.target
