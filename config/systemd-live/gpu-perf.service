[Unit]
Description=GPU Performance Settings (max clocks + power limit)
After=nvidia-persistenced.service
Requires=nvidia-persistenced.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -lgc 2100,2100 -i 1
ExecStart=/usr/bin/nvidia-smi -lmc 7000,7000 -i 1
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
