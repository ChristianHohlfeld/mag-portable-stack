[Unit]
Description=Open Terminal bare metal for OpenWebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris/open-terminal-files
Environment="HOME=/home/chris"
Environment="OPEN_TERMINAL_API_KEY=test-secret-123"
ExecStart=/home/chris/.local/bin/uvx open-terminal run --host 127.0.0.1 --port 8000 --api-key ${OPEN_TERMINAL_API_KEY}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
