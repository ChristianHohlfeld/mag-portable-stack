index 4e59d0ae0..94b426163 100644
--- a/ggml/src/ggml-cpu/arch-fallback.h
+++ b/ggml/src/ggml-cpu/arch-fallback.h
@@ -101,7 +101,7 @@
 #define ggml_gemv_iq4_nl_4x4_q8_0_generic ggml_gemv_iq4_nl_4x4_q8_0
 #define ggml_gemv_mxfp4_4x4_q8_0_generic ggml_gemv_mxfp4_4x4_q8_0
 #define ggml_gemv_q8_0_4x4_q8_0_generic ggml_gemv_q8_0_4x4_q8_0
-#define ggml_gemv_q8_0_4x8_q8_0_generic ggml_gemv_q8_0_4x8_q8_0
+// #define ggml_gemv_q8_0_4x8_q8_0_generic ggml_gemv_q8_0_4x8_q8_0  -- mag: eigene AVX2-Variante in arch/x86/repack.cpp
 #define ggml_gemm_q1_0_4x4_q8_0_generic ggml_gemm_q1_0_4x4_q8_0
 #define ggml_gemm_q1_0_4x8_q8_0_generic ggml_gemm_q1_0_4x8_q8_0
 #define ggml_gemm_q4_0_4x4_q8_0_generic ggml_gemm_q4_0_4x4_q8_0
@@ -114,7 +114,7 @@
 #define ggml_gemm_iq4_nl_4x4_q8_0_generic ggml_gemm_iq4_nl_4x4_q8_0
 #define ggml_gemm_mxfp4_4x4_q8_0_generic ggml_gemm_mxfp4_4x4_q8_0
 #define ggml_gemm_q8_0_4x4_q8_0_generic ggml_gemm_q8_0_4x4_q8_0
-#define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0
+// #define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0  -- mag: eigene AVX2-Variante in arch/x86/repack.cpp
 #elif defined(__POWERPC__) || defined(__powerpc__)
 // ref: https://github.com/ggml-org/llama.cpp/pull/14146#issuecomment-2972561679
 // quants.c
diff --git a/ggml/src/ggml-cpu/arch/x86/repack.cpp b/ggml/src/ggml-cpu/arch/x86/repack.cpp
index af1cebad1..c15147011 100644
--- a/ggml/src/ggml-cpu/arch/x86/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/x86/repack.cpp
@@ -6405,3 +6405,122 @@ void ggml_gemm_q2_K_8x8_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const vo
 
 #endif
 }
+
+// ---------------------------------------------------------------------------------------------
+// Q8_0 4x8 repack for AVX2 (mag-stack patch). Upstream only selects the Q8_0 repack on NEON and
+// RISC-V; on x86 Q8_0 weights fall back to the plain ggml_vec_dot_q8_0_q8_0 (one row at a time,
+// one accumulator). Layout (block_q8_0x4, see repack.cpp): per 32-value block, chunk k (0..3) holds
+// 8 int8 values of each of the 4 interleaved rows: [r0 k*8..+7][r1 ..][r2 ..][r3 ..] (32 bytes),
+// plus the 4 row scales d[0..3]. Activations for GEMM use the same 4-row interleave (quantize_mat_q8_0_4x8).
+// Products: maddubs(|w|, sign(a, w)) -> 16x int16, madd with ones -> 8x int32, i.e. 2 lanes per row.
+// ---------------------------------------------------------------------------------------------
+#if defined(__AVX2__)
+static inline __m256i mag_q8_0_dot_chunk(const __m256i w, const __m256i a) {
+    const __m256i ones = _mm256_set1_epi16(1);
+    const __m256i p16  = _mm256_maddubs_epi16(_mm256_sign_epi8(w, w), _mm256_sign_epi8(a, w));
+    return _mm256_madd_epi16(p16, ones);
+}
+// row scales d[0..3] duplicated per lane pair: [d0 d0 d1 d1 d2 d2 d3 d3]
+static inline __m256 mag_q8_0_pair_scales(const ggml_fp16_t * d) {
+#if defined(__F16C__)
+    const __m128i h = _mm_loadl_epi64((const __m128i *) d);          // d0 d1 d2 d3 (4x fp16)
+    return _mm256_cvtph_ps(_mm_unpacklo_epi16(h, h));                // d0 d0 d1 d1 d2 d2 d3 d3
+#else
+    return _mm256_setr_ps(GGML_CPU_FP16_TO_FP32(d[0]), GGML_CPU_FP16_TO_FP32(d[0]), GGML_CPU_FP16_TO_FP32(d[1]), GGML_CPU_FP16_TO_FP32(d[1]),
+                          GGML_CPU_FP16_TO_FP32(d[2]), GGML_CPU_FP16_TO_FP32(d[2]), GGML_CPU_FP16_TO_FP32(d[3]), GGML_CPU_FP16_TO_FP32(d[3]));
+#endif
+}
+// sum lane pairs of acc -> 4 floats (row 0..3)
+static inline __m128 mag_q8_0_pair_sum(const __m256 acc) {
+    const __m256 h = _mm256_hadd_ps(acc, acc);                       // [s0 s1 s0 s1 | s2 s3 s2 s3]
+    const __m128 lo = _mm256_castps256_ps128(h), hi = _mm256_extractf128_ps(h, 1);
+    return _mm_shuffle_ps(lo, hi, _MM_SHUFFLE(1, 0, 1, 0));          // [s0 s1 s2 s3]
+}
+#endif
+
+void ggml_gemv_q8_0_4x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__)
+    const int qk = QK8_0;
+    const int nb = n / qk;
+    assert(nr == 1);
+    assert(n % qk == 0);
+    assert(nc % 4 == 0);
+    UNUSED(bs);
+    UNUSED(nr);
+    const block_q8_0 * a_ptr = (const block_q8_0 *) vy;
+    for (int x = 0; x < nc / 4; x++) {
+        const block_q8_0x4 * b_ptr = (const block_q8_0x4 *) vx + (x * nb);
+        __m256 acc0 = _mm256_setzero_ps(), acc1 = _mm256_setzero_ps();
+        int l = 0;
+        for (; l + 1 < nb; l += 2) {     // two blocks per iteration -> two independent accumulators
+            for (int u = 0; u < 2; u++) {
+                const block_q8_0x4 * b = b_ptr + l + u;
+                const block_q8_0   * a = a_ptr + l + u;
+                __m256i isum = _mm256_setzero_si256();
+                for (int k = 0; k < 4; k++) {
+                    const __m256i w  = _mm256_loadu_si256((const __m256i *) (b->qs + k * 32));
+                    const __m256i av = _mm256_set1_epi64x(*(const int64_t *) (a->qs + k * 8));
+                    isum = _mm256_add_epi32(isum, mag_q8_0_dot_chunk(w, av));
+                }
+                const __m256 sc = _mm256_mul_ps(mag_q8_0_pair_scales(b->d), _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a->d)));
+                if (u == 0) acc0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(isum), sc, acc0);
+                else        acc1 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(isum), sc, acc1);
+            }
+        }
+        for (; l < nb; l++) {
+            const block_q8_0x4 * b = b_ptr + l;
+            const block_q8_0   * a = a_ptr + l;
+            __m256i isum = _mm256_setzero_si256();
+            for (int k = 0; k < 4; k++) {
+                const __m256i w  = _mm256_loadu_si256((const __m256i *) (b->qs + k * 32));
+                const __m256i av = _mm256_set1_epi64x(*(const int64_t *) (a->qs + k * 8));
+                isum = _mm256_add_epi32(isum, mag_q8_0_dot_chunk(w, av));
+            }
+            const __m256 sc = _mm256_mul_ps(mag_q8_0_pair_scales(b->d), _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a->d)));
+            acc0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(isum), sc, acc0);
+        }
+        _mm_storeu_ps(s + x * 4, mag_q8_0_pair_sum(_mm256_add_ps(acc0, acc1)));
+    }
+#else
+    ggml_gemv_q8_0_4x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
+
+void ggml_gemm_q8_0_4x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__)
+    const int qk = QK8_0;
+    const int nb = n / qk;
+    assert(n % qk == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 4 == 0);
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_0x4 * a_ptr = (const block_q8_0x4 *) vy + (y * nb);
+        for (int x = 0; x < nc / 4; x++) {
+            const block_q8_0x4 * b_ptr = (const block_q8_0x4 *) vx + (x * nb);
+            __m256 acc[4] = { _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps() };
+            for (int l = 0; l < nb; l++) {
+                const block_q8_0x4 * b = b_ptr + l;
+                const block_q8_0x4 * a = a_ptr + l;
+                __m256i isum[4] = { _mm256_setzero_si256(), _mm256_setzero_si256(), _mm256_setzero_si256(), _mm256_setzero_si256() };
+                for (int k = 0; k < 4; k++) {
+                    const __m256i w = _mm256_loadu_si256((const __m256i *) (b->qs + k * 32));
+                    for (int m = 0; m < 4; m++) {   // activation row m: 8 values of chunk k
+                        const __m256i av = _mm256_set1_epi64x(*(const int64_t *) (a->qs + k * 32 + m * 8));
+                        isum[m] = _mm256_add_epi32(isum[m], mag_q8_0_dot_chunk(w, av));
+                    }
+                }
+                const __m256 wsc = mag_q8_0_pair_scales(b->d);
+                for (int m = 0; m < 4; m++) {
+                    const __m256 sc = _mm256_mul_ps(wsc, _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(a->d[m])));
+                    acc[m] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(isum[m]), sc, acc[m]);
+                }
+            }
+            for (int m = 0; m < 4; m++) {
+                _mm_storeu_ps(s + (y * 4 + m) * bs + x * 4, mag_q8_0_pair_sum(acc[m]));
+            }
+        }
+    }
+#else
+    ggml_gemm_q8_0_4x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index 2632ae3a0..78fd5fe10 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -5103,6 +5103,14 @@ static const ggml::cpu::tensor_traits * ggml_repack_get_optimal_repack_type(cons
             }
         }
     } else if (cur->type == GGML_TYPE_Q8_0) {
+#if defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
+        // mag: AVX2-Kernels für q8_0_4x8 (arch/x86/repack.cpp)
+        if (ggml_cpu_has_avx2() && getenv("MAG_NO_Q8_0_REPACK") == nullptr) {
+            if (cur->ne[1] % 4 == 0) {
+                return &q8_0_4x8_q8_0;
+            }
+        }
+#endif
         if (ggml_cpu_has_neon() && ggml_cpu_has_matmul_int8()) {
             if (cur->ne[1] % 4 == 0) {
                 return &q8_0_4x8_q8_0;
