#!/usr/sbin/nft -f
# mag-audit: erzwingt, dass alle Bots über die zentrale Schnittstelle laufen.
# Platzhalter @…@ ersetzt install-audit.sh (UIDs, VM-Interfaces/-Netz).
# Eigene Tabelle -> kollidiert nicht mit bestehenden Regeln; komplett entfernbar mit:
#   nft delete table inet mag_audit

table inet mag_audit
delete table inet mag_audit

table inet mag_audit {
	set backend_ok_uids {
		type uid
		elements = { 0, @UID_MAG_AUDIT@ }
	}

	chain output {
		type filter hook output priority filter; policy accept;

		# 1) LLM backends (Q4 :8090 and IQ3 :8091) nur für root (Health) und mag-audit (Gateway).
		#    Alle anderen müssen über das Gateway :8080 -> lückenloses Log.
		ip daddr 127.0.0.1 tcp dport { 8090, 8091 } meta skuid != @backend_ok_uids counter reject with tcp reset

		# 2) Bot-User magbot: kein direkter Web-Zugriff, nur über mag-audit-webproxy (127.0.0.1:8888).
		#    VM-Netz bleibt erreichbar (Steuerung der Agent-VMs).
		meta skuid @UID_MAGBOT@ ip daddr != { 127.0.0.0/8, @VM_SUBNET@ } tcp dport { 80, 443, 8080, 8443 } counter reject with tcp reset
		meta skuid @UID_MAGBOT@ meta l4proto udp udp dport 443 counter reject   # QUIC/HTTP3
		meta skuid @UID_MAGBOT@ ip6 daddr != ::1 tcp dport { 80, 443 } counter reject with tcp reset
	}

	chain forward {
		type filter hook forward priority filter; policy accept;

		# 3) Agent-VMs: Web nur über den Proxy auf dem Host (der läuft im input-Pfad, nicht forward).
		iifname { @VM_IFACES@ } tcp dport { 80, 443, 8080, 8443 } counter reject with tcp reset
		iifname { @VM_IFACES@ } udp dport 443 counter reject
	}

	chain input {
		type filter hook input priority filter; policy accept;

		# 4) Proxy-Port 8888 nur von localhost und aus dem VM-Netz.
		tcp dport 8888 iifname "lo" accept
		tcp dport 8888 iifname { @VM_IFACES@ } accept
		tcp dport 8888 counter drop
		# 4b) Browser-Port 8889 (CONNECT ohne MITM): nur aus dem VM-Netz.
		tcp dport 8889 iifname { @VM_IFACES@ } accept
		tcp dport 8889 counter drop
		# Gateway (8080) und Backends (8090/8091) lauschen ohnehin nur auf 127.0.0.1.
	}
}
