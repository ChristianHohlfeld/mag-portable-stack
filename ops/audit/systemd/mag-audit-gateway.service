# Central model interface with a complete, hash-chained audit log. The room
# talks to :8080 only; the gateway forwards to the configured model servers.
# Model units are never started or stopped by this unit.
[Unit]
Description=MAG audit gateway (central LLM interface, full audit log)
After=network.target
Before=mag-120.service

[Service]
Type=simple
User=mag-audit
Group=mag-audit
SupplementaryGroups=magbot
UMask=0027
Environment=MAG_AUDIT_LISTEN_HOST=127.0.0.1
Environment=MAG_AUDIT_LISTEN_PORT=8080
Environment=MAG_AUDIT_UPSTREAM_HOST=127.0.0.1
# One slot per model server. The room routes by model ID.
Environment=MAG_ROOM_MODEL_ID=lena
Environment=MAG_ROOM_MODEL_PORTS=8191:0,8192:1,8193:2
Environment=MAG_ROOM_MODEL_ID_0=lena
Environment=MAG_ROOM_MODEL_ID_1=noah
Environment=MAG_ROOM_MODEL_ID_2=qwen
Environment="MAG_ROOM_MODEL_LABEL_2=Qwen 3.8 27B"
Environment="MAG_ROOM_MODEL_LABEL_0=Bot 0 (Gemma 4)"
Environment="MAG_ROOM_MODEL_LABEL_1=Bot 1 (Gemma 4)"
Environment=MAG_ROOM_BOTS_FILE=/var/lib/magbot/room/bots.json
Environment=MAG_MODELS_STATUS_FILE=/run/mag-models/status.json
Environment=MAG_AUDIT_LOG_DIR=/var/log/mag-audit
Environment=MAG_AUDIT_SECRETS_FILE=/etc/mag-audit/secrets.list
ExecStart=/opt/mag-audit/bin/mag-audit-gateway
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=mag-audit
ReadWritePaths=/var/log/mag-audit /var/lib/mag-audit
ReadOnlyPaths=/etc/mag-audit /opt/mag-audit -/var/lib/magbot/room/bots.json -/run/mag-models/status.json
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target

