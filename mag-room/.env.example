MAG_ROOM_BRAVE_KEY=<brave-search-api-key>
# Web Push. Generate locally; never commit the private key. See README section 14.
MAG_ROOM_VAPID_PUBLIC=
MAG_ROOM_VAPID_PRIVATE=
MAG_ROOM_VAPID_SUBJECT=mailto:mag@stardenburg.de
# Optional. Unset uses the binary and UI mtime so a deploy is not cached.
MAG_ROOM_VERSION=
# Seconds before a finished bot run sends a push. Default 15.
MAG_ROOM_PUSH_RUN_S=

# Coding-agent budgets: single user turn, including tool and model steps.
MAG_ROOM_MAX_STEPS=96
MAG_ROOM_RUN_BUDGET_S=14400
MAG_ROOM_GUEST_TIMEOUT=600
MAG_ROOM_TOOL_OUTPUT_LIMIT=32768
