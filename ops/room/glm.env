# Shared by magroom and mag-audit-gateway. port:NUMA, NOT port:llama-slot.
# Layout glm: two separately pinned GLM-5.3 quantizations; no DeepSeek service.
MAG_ROOM_MODEL_ID=glm-5.3-flash-iq1-m
MAG_ROOM_MODEL_LABEL="GLM-Q1 + GLM-Q2"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_THINKING=off
MAG_ROOM_GLM_CHAT_MAX_ROUNDS=2
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=glm-5.3-flash-iq1-m
MAG_ROOM_MODEL_LABEL_0="GLM-Q1"
MAG_ROOM_MODEL_ID_1=glm-5.3-flash
MAG_ROOM_MODEL_LABEL_1="GLM-Q2"
