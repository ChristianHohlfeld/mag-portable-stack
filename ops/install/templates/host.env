# /etc/mag-stack/host.env: who and where this MAG host is (not secret).
# ./install.sh writes it once from this template (the owner from sudo);
# change a value here and run sudo ./install.sh --from tls (or a deploy).
#
# The account that owns the models, the Idol environment and the checkout.
MAG_OWNER=chris
# The room's name (TLS via ACME DNS-01) and the zone of the bots' sites.
MAG_DOMAIN=mag.stardenburg.de
MAG_BOTS_ZONE=bot.stardenburg.de
# The host's Tailscale address and MagicDNS name (Gitea over Funnel).
# A fixed address keeps the DNS of MAG_DOMAIN valid on a new server: with a
# Tailscale API key in /etc/credstore/tailscale-api.key the installer moves
# it to the new node itself. Empty: whatever address the node has (then the
# DNS A records must point at it). The name is read from tailscale if empty.
MAG_TAILNET_IP=100.123.114.16
MAG_TS_NAME=
# Contact for Web Push (VAPID subject) and Let's Encrypt.
MAG_CONTACT=mailto:mag@stardenburg.de
