[Unit]
Description=MAG monthly encrypted restore smoke test
[Service]
Type=oneshot
UMask=0077
CPUAffinity=14-27 42-55
NUMAPolicy=bind
NUMAMask=1
Nice=19
IOSchedulingClass=idle
# Allow future IQ3 residency on NUMA node 1 without backup contention.
# Keep restic bounded to a fraction of one core and sacrifice backup first
# on memory pressure; no dependency/Conflicts with any LLM unit.
CPUQuota=15%
CPUWeight=1
IOWeight=10
MemoryHigh=512M
MemoryMax=2G
MemorySwapMax=0
OOMScoreAdjust=500
Environment=GOMAXPROCS=1
ExecStart=/usr/bin/numactl --cpunodebind=1 --membind=1 /usr/local/lib/mag-backup/maintenance.sh restore-test
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
