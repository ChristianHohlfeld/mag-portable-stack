[Unit]
Description=MAG Local LLM - DeepSeek V4 Flash via llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris

ExecStartPre=/usr/bin/test -r /home/chris/models/deepseek-v4/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf
ExecStartPre=/usr/bin/test -r /home/chris/llama-templates/deepseek-v4-flash-0731.jinja

ExecStart=/home/chris/.local/bin/llama serve \
  -m /home/chris/models/deepseek-v4/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf \
  --alias deepseek-v4-flash-0731 \
  --host 127.0.0.1 \
  --port 8080 \
  -c 32768 \
  -np 1 \
  -t 28 \
  -tb 28 \
  --numa distribute \
  --swa-full \
  --cache-ram 8192 \
  --ctx-checkpoints 32 \
  --checkpoint-min-step 8192 \
  -b 1024 \
  -ub 1024 \
  --jinja \
  --chat-template-file /home/chris/llama-templates/deepseek-v4-flash-0731.jinja \
  --reasoning-format deepseek \
  --flash-attn auto \
  --no-webui

Restart=always
RestartSec=2

MemorySwapMax=0
MemoryLow=80G
OOMScoreAdjust=-900

LimitNOFILE=1048576
LimitMEMLOCK=infinity

TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
