[Unit]
Description=MAG GitHub Actions runner (host mode, unprivileged)
After=network-online.target
Wants=network-online.target

[Service]
User=mag-ghrunner
Group=mag-ghrunner
SupplementaryGroups=mag-deploy
WorkingDirectory=/var/lib/mag-ghrunner/runner
Environment=HOME=/var/lib/mag-ghrunner
ExecStart=/var/lib/mag-ghrunner/runner/run.sh
Restart=always
RestartSec=10
# Never compete with the resident models.
Nice=15
IOSchedulingClass=idle
CPUQuota=200%
MemoryMax=6G
MemorySwapMax=0
OOMScoreAdjust=1000
TasksMax=512
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mag-ghrunner /var/lib/mag-deploy
InaccessiblePaths=-/etc/credstore -/var/backups -/var/lib/magbot -/var/lib/mag-llm -/etc/mag-backup -/var/lib/gitea -/etc/gitea -/var/lib/mag-runner -/var/lib/mag-botrunner

[Install]
WantedBy=multi-user.target
