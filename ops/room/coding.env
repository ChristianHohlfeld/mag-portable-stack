# Two CPU MoE room bots, one per NUMA node (owner decision 2026-11-02 22:18:
# "Zwei Top-Modelle, die schnell sind ... langen Code ... ohne abzubrechen"):
# NUMA0 Laguna S 2.1 (118B-A8B, Q4_K_M), NUMA1 Flint (40B-A2.5B, Q8_0).
# Long answers continue on finish_reason=length until the model stops
# (see magroom.cpp long_reply_model, #253). Room policy stays non-thinking
# (bot_thinking): Laguna answers directly; Flint always reasons (its template has no switch).
MAG_ROOM_MODEL_ID=laguna-s-2.1
MAG_ROOM_MODEL_LABEL="Laguna S 2.1 + Flint"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=off
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=laguna-s-2.1
MAG_ROOM_MODEL_LABEL_0="Laguna"
MAG_ROOM_MODEL_ID_1=flint
MAG_ROOM_MODEL_LABEL_1="Flint"
