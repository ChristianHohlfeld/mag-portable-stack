[Unit]
Description=MAG native C++ room with isolated KVM agents
After=network-online.target mag-llm.service libvirtd.service mag-agents-network.service
Wants=network-online.target libvirtd.service
# mag-llm is intentionally NOT in Wants=/Requires=/PartOf=/BindsTo= — never stop/restart LLM with the room

[Service]
Type=simple
User=magbot
Group=magbot
WorkingDirectory=/opt/mag-stack/current
EnvironmentFile=-/etc/default/mag-room
Environment=MAG_ROOM_STATE=/var/lib/magbot/room
Environment=MAG_ROOM_BIND=127.0.0.1
Environment=MAG_ROOM_STATIC=/opt/mag-stack/current/web/static
Environment=MAG_ROOM_UI=/opt/mag-stack/current/web/index.html
Environment=MAG_BROWSER_BINARY=/opt/mag-stack/current/bin/mag-browser
Environment=MAG_WHISPER_CLI=/opt/mag-stack/current/bin/whisper-cli
Environment=MAG_WHISPER_MODEL=/var/lib/mag-stack/models/ggml-large-v3-turbo.bin
ExecStart=/opt/mag-stack/current/bin/magroom
Restart=on-failure
RestartSec=2
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
UMask=0027
LimitNOFILE=65536
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
