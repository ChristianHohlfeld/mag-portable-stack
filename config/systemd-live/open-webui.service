[Unit]
Description=Open WebUI bare metal
After=network-online.target tailscaled.service ollama.service open-terminal.service opencode-server.service
Wants=network-online.target tailscaled.service ollama.service open-terminal.service opencode-server.service

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris
Environment="HOME=/home/chris"
Environment="DATA_DIR=/home/chris/.open-webui"
Environment="HOST=0.0.0.0"
Environment="PORT=3000"
Environment="ENABLE_WEBSOCKET_SUPPORT=true"
Environment="UVICORN_WORKERS=1"
Environment="OLLAMA_BASE_URL=http://127.0.0.1:11434"
Environment="WEBUI_URL=https://mag.tail3e02ae.ts.net"
Environment="CORS_ALLOW_ORIGIN=http://100.123.114.16:3000;https://mag.tail3e02ae.ts.net;http://127.0.0.1:3000;http://localhost:3000"
ExecStart=/home/chris/.local/bin/open-webui-wrapper.sh
# Original: /home/chris/.local/bin/uvx --python 3.11 open-webui@latest serve --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
Environment="ENABLE_EVALUATION_ARENA_MODELS=false"
