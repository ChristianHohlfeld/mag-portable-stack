MAG_ROOM_BRAVE_KEY=<brave-search-api-key>
# Web Push. Generate locally; never commit the private key. See README section 14.
MAG_ROOM_VAPID_PUBLIC=
MAG_ROOM_VAPID_PRIVATE=
MAG_ROOM_VAPID_SUBJECT=mailto:mag@stardenburg.de
# Optional. Unset uses the binary and UI mtime so a deploy is not cached.
MAG_ROOM_VERSION=
# Seconds before a finished bot run sends a push. Default 15.
MAG_ROOM_PUSH_RUN_S=

# Coding-agent budgets: single user turn, including tool and model steps.
MAG_ROOM_MAX_STEPS=96
MAG_ROOM_RUN_BUDGET_S=14400
MAG_ROOM_GUEST_TIMEOUT=600
MAG_ROOM_TOOL_OUTPUT_LIMIT=32768

# Conservative wire-byte guard for the 32768-token Q4/IQ3 server context.
# Includes tool schemas; on upstream context HTTP 400 MAG shrinks and retries.
MAG_ROOM_CONTEXT_BYTES=52000
# Only the newest room transcript lines are sent, persistent room stays intact.
MAG_ROOM_TRANSCRIPT_BYTES=16000
# Cap each tool result carried to subsequent model steps (full trace in room).
MAG_ROOM_TOOL_CONTEXT_BYTES=6000

# Live default: two DeepSeek V4 Flash bots, one single-slot server per NUMA.
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_SINGLE_BOT_VM=on
MAG_ROOM_MODEL_ID=deepseek-v4-flash-0731
MAG_ROOM_MODEL_LABEL="DeepSeek V4 Flash"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_THINKING=on
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
