# Local Gitea for MAG. HTTP stays on loopback. Tailscale Funnel publishes
# :443 as HTTPS and proxies to 127.0.0.1:3000. :8445 stays tailnet-only.
# Matches the unit running on mag. Sandboxing (ProtectSystem/ProtectHome)
# is not enabled until it has been verified against the live Gitea.
[Unit]
Description=MAG Gitea Git Server
After=network.target

[Service]
Type=simple
User=git
Group=git
WorkingDirectory=/var/lib/gitea
Environment=HOME=/var/lib/gitea
Environment=GITEA_WORK_DIR=/var/lib/gitea
ExecStart=/usr/local/bin/gitea web --config /etc/gitea/app.ini
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
