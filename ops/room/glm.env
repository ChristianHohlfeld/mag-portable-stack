# GLM room: Mistral Large 4 on NUMA0 (:8191) + unchanged GLM-Q2 on NUMA1 (:8192).
# Mistral is chat-only; deployment is gated by all six verified UD-IQ1_S shards.
MAG_ROOM_MODEL_ID=mistral-large4
MAG_ROOM_MODEL_LABEL="Mistral + GLM-Q2"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=on
MAG_ROOM_GLM_CHAT_MAX_ROUNDS=0
MAG_ROOM_GLM_CHAT_MAX_TOKENS=1024
MAG_ROOM_GLM_CODE_MAX_TOKENS=8192
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=mistral-large4
MAG_ROOM_MODEL_LABEL_0="Mistral"
MAG_ROOM_MODEL_ID_1=glm-5.3-flash
MAG_ROOM_MODEL_LABEL_1="GLM-Q2"
