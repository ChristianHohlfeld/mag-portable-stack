MAG_ROOM_BRAVE_KEY=<brave-search-api-key>
# Web Push. Generate locally; never commit the private key. See README section 14.
MAG_ROOM_VAPID_PUBLIC=
MAG_ROOM_VAPID_PRIVATE=
MAG_ROOM_VAPID_SUBJECT=mailto:mag@stardenburg.de
# Optional. Unset uses the binary and UI mtime so a deploy is not cached.
MAG_ROOM_VERSION=
# Seconds before a finished bot run sends a push. Default 15.
MAG_ROOM_PUSH_RUN_S=

# Coding-agent budgets: single user turn, including tool and model steps.
MAG_ROOM_MAX_STEPS=96
MAG_ROOM_RUN_BUDGET_S=14400
MAG_ROOM_GUEST_TIMEOUT=600
MAG_ROOM_TOOL_OUTPUT_LIMIT=32768

# Conservative wire-byte guard for the 32768-token Q4/IQ3 server context.
# Includes tool schemas; on upstream context HTTP 400 MAG shrinks and retries.
MAG_ROOM_CONTEXT_BYTES=52000
# PhoLine for NEW room-to-model messages too. Existing history is handled by
# Native PhO-Compress on cold transcript/context rollover. Opt-in; default 0
# when unset. Also requires the per-bot PhO-Compress switch. Set to 1 only
# after local tests. Roll back with 0 and a room restart. Already-sent wire
# messages are left unchanged.
MAG_ROOM_PHO_LIVE=0
# Coding context: disable PhoLine in both live and archive; it is lossy text compression.
MAG_ROOM_CODING_PHO=0
# Dynamic conversation budgets (not max generation tokens or complete code limits).
MAG_ROOM_NOAH_CONTEXT_TOKENS=4096
MAG_ROOM_LENA_CONTEXT_TOKENS=8192
# Rollover happens only when room byte budget is exceeded, not every turn.
MAG_ROOM_CONTEXT_MASKING=1
# Per-ROOM-Bot total prompt token ceiling, measured via /apply-template + /tokenize.
MAG_ROOM_LENA_PROMPT_TOKENS=8192
MAG_ROOM_NOAH_PROMPT_TOKENS=4096
# Noah excluded only from Room scheduler; NUMA1 model stays loaded.
MAG_ROOM_NOAH_ENABLED=1
# Stable small tool set; other tools exposed through tool_list/tool_call.
MAG_ROOM_CODING_LAZY_TOOLS=1
MAG_ROOM_CODING_MAX_STEPS=12
# MI50 expected fresh prefill <= 500 tokens; CPU Noah <= 50.
# If a cold cache violates these targets, the room logs a warning.

# Tool output above this limit is stored verbatim and referenced, never cut.
MAG_ROOM_TOOL_CONTEXT_BYTES=6000
# Only the newest room transcript lines are sent, persistent room stays intact.
MAG_ROOM_TRANSCRIPT_BYTES=16000

# Live default: two DeepSeek V4 Flash bots, one single-slot server per NUMA.
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_SINGLE_BOT_VM=on
MAG_ROOM_MODEL_ID=deepseek-v4-flash-0731
MAG_ROOM_MODEL_LABEL="DeepSeek V4 Flash"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_THINKING=on
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
