# Ornith-1.5-35B-A3B, one server per NUMA node (variant B): %i = node 0|1,
# port 8191+%i, --parallel 2 (two room bots each), start-node.sh. Per-node CPU and
# memory pinning in mag-llm-ornith-node@%i.service.d/10-numa.conf (ops/ornith/nodes/).
# Replaces mag-llm-ornith@1..4, which stay installed (disabled) for rollback.sh instances.
# Installed and started only by ops/ornith/cutover.sh; mag-llm is independent.
[Unit]
Description=MAG Ornith-1.5-35B-A3B CPU model, NUMA node %i (2 bots)
After=network-online.target mag-llm.service
Wants=network-online.target
ConditionPathExists=/etc/mag-ornith/model.sha256
Conflicts=mag-llm-qwen.service mag-llm-ornith@1.service mag-llm-ornith@2.service mag-llm-ornith@3.service mag-llm-ornith@4.service
StartLimitIntervalSec=1800
StartLimitBurst=2
[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris
ExecStartPre=+/usr/bin/install -d -o chris -g chris -m 0750 /var/lib/mag-llm/slots/ornith-node%i
# Full SHA-256 once as root (shared lock + stamp); start-node.sh rechecks the stamp.
ExecStartPre=+/usr/local/lib/mag-ornith/verify-model.sh
ExecStart=/usr/local/lib/mag-ornith/start-node.sh %i
Restart=on-failure
RestartSec=60
TimeoutStartSec=3600
TimeoutStopSec=120
# ~21.8 GiB RSS (weights mlocked + KV for 2x32k) + 2 GiB --cache-ram ≈ 23.8 GiB:
# MemoryHigh stays above RSS+cache-ram, MemoryMax leaves 3 GiB for spikes.
MemoryAccounting=yes
MemoryHigh=25G
MemoryMax=28G
MemorySwapMax=0
LimitMEMLOCK=infinity
OOMScoreAdjust=-600
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=-/var/lib/mag-llm/slots/ornith-node%i
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
[Install]
WantedBy=multi-user.target
