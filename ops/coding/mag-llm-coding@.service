# Two independent NUMA model servers, 8191 and 8192, with per-model slot caches.
[Unit]
Description=MAG coding model NUMA%i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=2

[Service]
Type=simple
User=chris
Group=chris
# NUMA0 drives the MI50 through /dev/dri/renderD128 (Vulkan/RADV).
SupplementaryGroups=render video
WorkingDirectory=/home/chris
ExecStart=/usr/local/lib/mag-coding/start-live.sh %i
# Every stop/restart first saves the slot KV + checkpoints (5 s idle wait, an
# in-flight turn is not waited for: Chris aborts hangs immediately).
ExecStop=-/usr/bin/env MAG_SLOT_SAVE_WAIT_S=5 /bin/bash /usr/local/lib/mag-coding/save-slots.sh --node %i
Restart=on-failure
RestartSec=30
# First start hashes and mlocks up to 98 GB on one node.
TimeoutStartSec=7200
TimeoutStopSec=120
CPUAccounting=yes
MemoryAccounting=yes
MemorySwapMax=0
# NUMA0 Vulkan: device-local VRAM only (no BAR heap spill into GTT/system RAM).
Environment=GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM=1
LimitMEMLOCK=infinity
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/mag-llm/slots/coding
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
