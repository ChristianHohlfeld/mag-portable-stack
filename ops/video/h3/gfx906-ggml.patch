diff --git a/src/ggml-cuda/conv3d_dot2_gfx906.cuh b/src/ggml-cuda/conv3d_dot2_gfx906.cuh
new file mode 100644
index 00000000..c4e30c27
--- /dev/null
+++ b/src/ggml-cuda/conv3d_dot2_gfx906.cuh
@@ -0,0 +1,100 @@
+// The MI50's (gfx906) own implicit fp16 GEMM for Conv3d: the same 64x64x64
+// tiles, split over k, and output as ggml's conv3d_implicit_gemm_f16, but the
+// patches lie in LDS as pairs along k, so that every pair of fp16 products
+// goes into an fp32 sum with one v_dot2_f32_f16, instead of two conversions
+// and two scalar FMAs per product on GCN without MFMA. The input is ggml's
+// padded fp16 copy. Self-contained (Params needs conv3d_params' fields) so a
+// small program can check it against a Conv3d on the CPU. MAG stack.
+#pragma once
+#include <cstdint>
+
+typedef _Float16 conv3d_half2_t __attribute__((ext_vector_type(2)));
+
+template <int KW, int KH, int KD, typename Params>
+static __global__ void __launch_bounds__(256) conv3d_implicit_gemm_dot2(const _Float16 * __restrict__ input,
+                                                                         const _Float16 * __restrict__ weight,
+                                                                         float * __restrict__ output,
+                                                                         const Params P,
+                                                                         const int split_k,
+                                                                         const bool aligned_weights) {
+    constexpr int BM = 64, BN = 64, BK = 64, KP = BK / 2;
+    __shared__ __attribute__((aligned(16))) conv3d_half2_t a_s[BM][KP + 4];   // [output channel][pair of k]
+    __shared__ __attribute__((aligned(16))) conv3d_half2_t b_s[KP][BN + 4];   // [pair of k][position]
+    const int tid = threadIdx.x;
+    const int iw = int(P.IW), ih = int(P.IH), id = int(P.ID);
+    const int ow = int(P.OW), oh = int(P.OH), od = int(P.OD);
+    const int kw = KW ? KW : int(P.KW), kh = KH ? KH : int(P.KH), kd = KD ? KD : int(P.KD);
+    const int ic = int(P.IC), oc = int(P.OC);
+    const int sx = int(P.ST_X), sy = int(P.ST_Y), sz = int(P.ST_Z);
+    const int dx = int(P.DL_X), dy = int(P.DL_Y), dz = int(P.DL_Z);
+    const int n = blockIdx.z / split_k, split = blockIdx.z % split_k;
+    const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+    const int k_total = ic * kw * kh * kd, positions = ow * oh * od;
+
+    // The position this thread loads (one column of b_s) and where its patch starts.
+    const int b_col = tid % BN, b_pair0 = tid / BN;   // 4 threads per column
+    const int spatial = n0 + b_col, valid = spatial < positions;
+    const int sp = valid ? spatial : 0;
+    const int pos = ((sp / (ow * oh)) * sz * ih + (sp / ow % oh) * sy) * iw + (sp % ow) * sx;
+
+    const int simt_m = tid / 16 * 4, simt_n = tid % 16 * 4;
+    float c[4][4] = {};
+    const int tiles = (k_total + BK - 1) / BK;
+    const int begin = int(int64_t(tiles) * split / split_k) * BK;
+    const int end   = int(int64_t(tiles) * (split + 1) / split_k) * BK;
+    for (int k0 = begin; k0 < end; k0 += BK) {
+        if (aligned_weights) {
+            for (int i = tid; i < BM * BK / 8; i += 256) {
+                const int row = i / (BK / 8), col = 8 * (i % (BK / 8));
+                const int4 v = m0 + row < oc && k0 + col < k_total ? ((const int4 *) weight)[((m0 + row) * k_total + k0 + col) / 8]
+                                                                    : make_int4(0, 0, 0, 0);
+                *(int4 *) &a_s[row][col / 2] = v;
+            }
+        } else {
+            for (int i = tid; i < BM * KP; i += 256) {
+                const int row = i / KP, col = 2 * (i % KP);
+                conv3d_half2_t v = {(_Float16) 0.f, (_Float16) 0.f};
+                if (m0 + row < oc && k0 + col < k_total) {
+                    v.x = weight[(m0 + row) * k_total + k0 + col];
+                    if (k0 + col + 1 < k_total) v.y = weight[(m0 + row) * k_total + k0 + col + 1];
+                }
+                a_s[row][col / 2] = v;
+            }
+        }
+#pragma unroll
+        for (int pair = b_pair0; pair < KP; pair += 256 / BN) {
+            conv3d_half2_t v = {(_Float16) 0.f, (_Float16) 0.f};
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int ki = k0 + 2 * pair + h;
+                if (valid && ki < k_total) {
+                    const int ci = ki / (kw * kh * kd), kz = ki / (kw * kh) % kd, ky = ki / kw % kh, kx = ki % kw;
+                    const _Float16 x = input[((n * ic + ci) * id + kz * dz) * ih * iw + ky * dy * iw + kx * dx + pos];
+                    if (h == 0) v.x = x; else v.y = x;
+                }
+            }
+            b_s[pair][b_col] = v;
+        }
+        __syncthreads();
+#pragma unroll 8
+        for (int pair = 0; pair < KP; ++pair) {
+            conv3d_half2_t a[4], b[4];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) a[i] = a_s[simt_m + i][pair];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) b[j] = b_s[pair][simt_n + j];
+#pragma unroll
+            for (int i = 0; i < 4; ++i)
+#pragma unroll
+                for (int j = 0; j < 4; ++j) c[i][j] = __builtin_amdgcn_fdot2(a[i], b[j], c[i][j], false);
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int i = 0; i < 4; ++i)
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const int co = m0 + simt_m + i, p = n0 + simt_n + j;
+            if (co < oc && p < positions) output[(int64_t(blockIdx.z) * oc + co) * positions + p] = c[i][j];
+        }
+}
diff --git a/src/ggml-cuda/gemm_q8_gfx906.cuh b/src/ggml-cuda/gemm_q8_gfx906.cuh
new file mode 100644
index 00000000..9801dae8
--- /dev/null
+++ b/src/ggml-cuda/gemm_q8_gfx906.cuh
@@ -0,0 +1,168 @@
+// The MI50's (gfx906) own W8A8 GEMM for Q8_0 weights, for long token runs
+// (H3's linear layers): dst[n][m] = sum_k W[m][k] * X[n][k].
+//  1. repack: the Q8_0 weights (34-byte blocks, only 2-byte aligned) into an
+//     aligned int8 matrix and one fp32 scale per block of 32, so that every
+//     load of the GEMM is a 16-byte vector;
+//  2. quantize_x: X (fp32) to int8 per block of 32 with one scale (as Q8_0);
+//  3. gemm: 128x128 output tiles, k in steps of 128 (four blocks), 256
+//     threads of 8x8 outputs each; v_dot4_i32_i8 (four int8 products per
+//     instruction) into int32 per block, into fp32 with both scales; the next
+//     k-step is loaded into registers while the current one is computed from
+//     LDS (word-major, 128-bit reads).
+// Self-contained so that a small program can check it against the plain
+// product on the CPU. MAG stack.
+#pragma once
+#include <cstdint>
+
+namespace gfx906_q8 {
+    constexpr int QK = 32;                 // values per Q8_0 block
+    constexpr int BLOCK_BYTES = 34;        // fp16 scale + 32 int8
+    constexpr int BM = 128, BN = 128;      // output tile: weight rows x tokens
+    constexpr int KB = 4;                  // blocks of 32 per k-step (k step 128)
+    constexpr int WORDS = KB * QK / 4;     // int32 words of a row per k-step (32)
+
+    // Q8_0 rows -> wq [m][k] int8 and ws [m][k/32] fp32; one block per thread.
+    static __global__ void repack(const uint8_t * __restrict__ w, int64_t row_bytes, int8_t * __restrict__ wq,
+                                  float * __restrict__ ws, int64_t blocks_total, int k) {
+        const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+        if (i >= blocks_total) return;
+        const int kb = k / QK;
+        const int64_t row = i / kb, b = i % kb;
+        const uint16_t * src = reinterpret_cast<const uint16_t *>(w + row * row_bytes + b * BLOCK_BYTES);
+        ws[i] = float(*reinterpret_cast<const _Float16 *>(src));
+        int words[QK / 4];
+#pragma unroll
+        for (int j = 0; j < QK / 4; ++j) words[j] = int(src[1 + 2 * j]) | (int(src[2 + 2 * j]) << 16);
+        int4 * dst = reinterpret_cast<int4 *>(wq + row * k + b * QK);
+        dst[0] = make_int4(words[0], words[1], words[2], words[3]);
+        dst[1] = make_int4(words[4], words[5], words[6], words[7]);
+    }
+
+    // X (fp32 rows of k, stride row_stride floats) -> xq [rows][k] int8, xs [rows][k/32].
+    static __global__ void quantize_x(const float * __restrict__ x, int8_t * __restrict__ xq, float * __restrict__ xs,
+                                      int64_t blocks_total, int k, int64_t row_stride) {
+        const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+        if (i >= blocks_total) return;
+        const int kb = k / QK;
+        const int64_t row = i / kb, b = i % kb;
+        const float * src = x + row * row_stride + b * QK;
+        float v[QK], peak = 0.f;
+#pragma unroll
+        for (int j = 0; j < QK; ++j) { v[j] = src[j]; peak = fmaxf(peak, fabsf(v[j])); }
+        const float inv = peak > 0.f ? 127.f / peak : 0.f;
+        int words[QK / 4];
+#pragma unroll
+        for (int w = 0; w < QK / 4; ++w) {
+            int packed = 0;
+#pragma unroll
+            for (int j = 0; j < 4; ++j)
+                packed |= (__float2int_rn(fminf(fmaxf(v[4 * w + j] * inv, -127.f), 127.f)) & 0xff) << (8 * j);
+            words[w] = packed;
+        }
+        int4 * dst = reinterpret_cast<int4 *>(xq + row * k + b * QK);
+        dst[0] = make_int4(words[0], words[1], words[2], words[3]);
+        dst[1] = make_int4(words[4], words[5], words[6], words[7]);
+        xs[i] = peak / 127.f;
+    }
+
+    struct Tile {          // one k-step of one thread, in registers: 4 x 16 bytes of W and of X, 2 scales each
+        int4 a[4], b[4];
+        float sa[2], sb[2];
+    };
+
+    // Thread t loads the 16-byte pieces t, t+256, t+512, t+768 of each 128 x 128-byte tile
+    // (piece p: row p % 128, chunk p / 128 of 8), and the scales t and t+256 of 128 x 4.
+    static __device__ __forceinline__ void load(Tile & r, const int8_t * __restrict__ wq, const float * __restrict__ ws,
+                                                const int8_t * __restrict__ xq, const float * __restrict__ xs,
+                                                int m0, int n0, int kb0, int m, int n, int k, int tid) {
+        const int kb_total = k / QK;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const int p = tid + 256 * i, row = p % 128, chunk = p / 128, kbyte = kb0 * QK + chunk * 16;
+            const bool kin = kbyte < k;
+            r.a[i] = m0 + row < m && kin ? *reinterpret_cast<const int4 *>(wq + int64_t(m0 + row) * k + kbyte) : make_int4(0, 0, 0, 0);
+            r.b[i] = n0 + row < n && kin ? *reinterpret_cast<const int4 *>(xq + int64_t(n0 + row) * k + kbyte) : make_int4(0, 0, 0, 0);
+        }
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            const int p = tid + 256 * i, row = p % 128, blk = p / 128, kb = kb0 + blk;
+            r.sa[i] = m0 + row < m && kb < kb_total ? ws[int64_t(m0 + row) * kb_total + kb] : 0.f;
+            r.sb[i] = n0 + row < n && kb < kb_total ? xs[int64_t(n0 + row) * kb_total + kb] : 0.f;
+        }
+    }
+
+    // grid (ceil(n/128), ceil(m/128)), 256 threads.
+    static __global__ void __launch_bounds__(256) gemm(const int8_t * __restrict__ wq, const float * __restrict__ ws,
+                                                       const int8_t * __restrict__ xq, const float * __restrict__ xs,
+                                                       float * __restrict__ dst, int64_t dst_row_stride, int m, int n, int k) {
+        __shared__ __attribute__((aligned(16))) int a_s[WORDS][BM];   // [word][weight row]  16 KB
+        __shared__ __attribute__((aligned(16))) int b_s[WORDS][BN];   // [word][token]       16 KB
+        __shared__ float sa_s[KB][BM], sb_s[KB][BN];                  //                      4 KB
+        const int tid = threadIdx.x, ty = tid / 16, tx = tid % 16;
+        const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+        const int kb_total = k / QK;
+        float c[8][8] = {};
+        Tile r;
+        load(r, wq, ws, xq, xs, m0, n0, 0, m, n, k, tid);
+        for (int kb0 = 0; kb0 < kb_total; kb0 += KB) {
+            // registers -> LDS (word-major; consecutive lanes write consecutive rows)
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                const int p = tid + 256 * i, row = p % 128, w0 = (p / 128) * 4;
+                a_s[w0 + 0][row] = r.a[i].x; a_s[w0 + 1][row] = r.a[i].y; a_s[w0 + 2][row] = r.a[i].z; a_s[w0 + 3][row] = r.a[i].w;
+                b_s[w0 + 0][row] = r.b[i].x; b_s[w0 + 1][row] = r.b[i].y; b_s[w0 + 2][row] = r.b[i].z; b_s[w0 + 3][row] = r.b[i].w;
+            }
+#pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                const int p = tid + 256 * i;
+                sa_s[p / 128][p % 128] = r.sa[i];
+                sb_s[p / 128][p % 128] = r.sb[i];
+            }
+            __syncthreads();
+            // the next k-step into registers while this one is computed
+            if (kb0 + KB < kb_total) load(r, wq, ws, xq, xs, m0, n0, kb0 + KB, m, n, k, tid);
+#pragma unroll
+            for (int blk = 0; blk < KB; ++blk) {
+                int acc[8][8] = {};
+#pragma unroll
+                for (int j = 0; j < QK / 4; ++j) {
+                    const int w = blk * (QK / 4) + j;
+                    const int4 a0 = *reinterpret_cast<const int4 *>(&a_s[w][ty * 8]);
+                    const int4 a1 = *reinterpret_cast<const int4 *>(&a_s[w][ty * 8 + 4]);
+                    const int4 b0 = *reinterpret_cast<const int4 *>(&b_s[w][tx * 8]);
+                    const int4 b1 = *reinterpret_cast<const int4 *>(&b_s[w][tx * 8 + 4]);
+                    const int a[8] = {a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w};
+                    const int b[8] = {b0.x, b0.y, b0.z, b0.w, b1.x, b1.y, b1.z, b1.w};
+#pragma unroll
+                    for (int i = 0; i < 8; ++i)
+#pragma unroll
+                        for (int t = 0; t < 8; ++t) acc[i][t] = __builtin_amdgcn_sdot4(a[i], b[t], acc[i][t], false);
+                }
+                float br[8];
+#pragma unroll
+                for (int t = 0; t < 8; ++t) br[t] = sb_s[blk][tx * 8 + t];
+#pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const float ar = sa_s[blk][ty * 8 + i];
+#pragma unroll
+                    for (int t = 0; t < 8; ++t) c[i][t] = fmaf(float(acc[i][t]) * br[t], ar, c[i][t]);
+                }
+            }
+            __syncthreads();
+        }
+#pragma unroll
+        for (int t = 0; t < 8; ++t) {
+            const int tok = n0 + tx * 8 + t;
+            if (tok >= n) continue;
+            float * out = dst + int64_t(tok) * dst_row_stride + m0 + ty * 8;
+            if (m0 + ty * 8 + 8 <= m && (reinterpret_cast<uintptr_t>(out) & 15) == 0) {
+                reinterpret_cast<float4 *>(out)[0] = make_float4(c[0][t], c[1][t], c[2][t], c[3][t]);
+                reinterpret_cast<float4 *>(out)[1] = make_float4(c[4][t], c[5][t], c[6][t], c[7][t]);
+            } else {
+#pragma unroll
+                for (int i = 0; i < 8; ++i)
+                    if (m0 + ty * 8 + i < m) out[i] = c[i][t];
+            }
+        }
+    }
+}
