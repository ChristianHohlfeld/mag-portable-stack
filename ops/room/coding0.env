# Node-scoped interim of the coding room: Qwen3.8-Flash-Next on NUMA0 (:8191)
# while GLM-Q2 keeps NUMA1 (:8192) until Qwen3-Coder-Next is downloaded and
# SHA-verified; the next deploy then switches NUMA1 (ops/coding/layout.sh).
MAG_ROOM_MODEL_ID=qwen3.8-flash-next
MAG_ROOM_MODEL_LABEL="Qwen3.8 + GLM-Q2"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=on
MAG_ROOM_GLM_CHAT_MAX_TOKENS=1024
MAG_ROOM_GLM_CODE_MAX_TOKENS=8192
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=qwen3.8-flash-next
MAG_ROOM_MODEL_LABEL_0="Qwen3.8"
MAG_ROOM_MODEL_ID_1=glm-5.3-flash
MAG_ROOM_MODEL_LABEL_1="GLM-Q2"
