# Copy only the desired options to /etc/mag-backup/config.env (root:root 0600)
# Never commit an actual value from a production host.
MAG_BACKUP_REPO=/var/backups/mag-restic
MAG_BACKUP_WORK=/var/lib/mag-backup/work
MAG_BACKUP_BUCKET=mag-backup-595505951010-euc1
MAG_BACKUP_LOCK_WAIT=120
MAG_BACKUP_S3_BANDWIDTH=4MB/s

# Explicit operator consent required; residual aws.env MUST NOT activate AWS.
# Keep 0 while AWS is stopped (including local pre-deploy snapshots).
MAG_BACKUP_OFFSITE_ENABLED=0
