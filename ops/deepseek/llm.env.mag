# Canonical Q4 start values for a fresh /etc/mag-llm/llm.env.
# One model, both sockets. The node0 bind was model isolation and is off:
# it used one memory bus and 14 cores, which is why prefill sits for minutes.
# These are the values already measured on mag (ops/mag-llm.service):
# interleave across both sockets, 28 physical cores, ubatch 2048 so each
# expert sees more prompt tokens per pass. Hyperthreads stay off; on these
# Broadwells they share the AVX2 units and the memory bus.
# Bootstrap copies this file only when the host file is absent.
# A running mag-llm keeps the old placement until warm.sh restart-llm.
# Do not run ops/deepseek/numa-isolation.sh; it writes the node0 bind back.
ENGINE=ik
IK_BIN=/home/chris/.local/ik/8d21687cc7-mag-c96826ab/bin/llama-server
THREADS=28
THREADS_BATCH=28
BATCH=2048
UBATCH=2048
NUMA_ARGS="--interleave=all"
LLAMA_NUMA=distribute
IK_RTR=1
IK_ENV="GGML_Q8_PF=4096 GGML_MXFP4_PF=4096"
IK_SLOT_SAVE=1
IK_SLOT_SAVE_PATH=/var/lib/mag-llm/slots
IK_CRS=0.20
LOAD_ARGS="--load-mode mmap+mlock"
