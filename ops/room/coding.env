# Lena NUMA0: Qwen3.8-27B Q6_K (MI50 Vulkan); Noah NUMA1: DeepSeek V4 Flash UD-IQ3_XXS CPU.
# Stable wire IDs preserve existing agents and slots.
MAG_ROOM_MODEL_ID=ornith-numa0
MAG_ROOM_MODEL_LABEL="Qwen3.8-27B Q6_K + DeepSeek V4 Flash"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=off
# Noah checks Lena after she answers; Lena keeps the existing no-thinking fast path.
MAG_ROOM_NOAH_REVIEW=1
MAG_ROOM_GROUP_STAGGER=reply
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
# PhO-Compress removed from the room path (owner 2026-11-03 12:08).
MAG_ROOM_PHO=0
MAG_ROOM_MODEL_ID_0=ornith-numa0
MAG_ROOM_MODEL_LABEL_0="Qwen3.8-27B Q6_K"
MAG_ROOM_MODEL_ID_1=ornith
MAG_ROOM_MODEL_LABEL_1="DeepSeek V4 Flash"

# MAG :8191 Lena MI50; :8192 Noah CPU (resident but not scheduled).
MAG_ROOM_NOAH_ENABLED=0
MAG_ROOM_CONTEXT_MASKING=1
MAG_ROOM_LENA_CONTEXT_TOKENS=8192
MAG_ROOM_NOAH_CONTEXT_TOKENS=4096
MAG_ROOM_LENA_PROMPT_TOKENS=8192
MAG_ROOM_NOAH_PROMPT_TOKENS=4096
MAG_ROOM_CODING_LAZY_TOOLS=1
MAG_ROOM_CODING_MAX_STEPS=12
