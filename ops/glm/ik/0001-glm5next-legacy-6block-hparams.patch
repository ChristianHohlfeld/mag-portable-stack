From 6b6d2c2e7f4d6d1c9b6f8d5a2e3c4b5a6d7e8f90 Mon Sep 17 00:00:00 2001
From: MAG Build <mag@localhost>
Date: Sat, 31 Oct 2026 22:00:00 +0000
Subject: [PATCH] glm5next: load legacy 6block hparams metadata

The legacy 6block converter writes a scalar head_count_kv=1 and uses
attention.indexer.block_size instead of attention.indexer.kpool.
Reconstruct the per-layer KDA/MLA pattern from full_attention_interval
and accept the legacy block_size key without touching tensors.

---
 src/llama-hparams.cpp | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/llama-hparams.cpp b/src/llama-hparams.cpp
index 0000000..0000000 100644
--- a/src/llama-hparams.cpp
+++ b/src/llama-hparams.cpp
@@ -2511,10 +2511,16 @@
                 ml.get_key(LLM_KV_ATTENTION_INDEXER_HEAD_COUNT, hparams.indexer_n_head,    false);
                 ml.get_key(LLM_KV_ATTENTION_INDEXER_KEY_LENGTH, hparams.indexer_head_size, false);
                 ml.get_key(LLM_KV_ATTENTION_INDEXER_TOP_K,      hparams.indexer_top_k,     false);
-                ml.get_key(LLM_KV_ATTENTION_INDEXER_KPOOL,      hparams.indexer_block_size, false);
+                if (!ml.get_key(LLM_KV_ATTENTION_INDEXER_KPOOL, hparams.indexer_block_size, false)) {
+                    // Legacy 6block GGUF uses attention.indexer.block_size.
+                    ml.get_key("glm5next.attention.indexer.block_size", hparams.indexer_block_size, false);
+                }
                 if (hparams.indexer_head_size > 0) {
                     GGML_ASSERT(hparams.indexer_n_head > 0 && "GLM5NEXT indexer key length without indexer head count");
                     if (hparams.indexer_block_size > 0 && hparams.indexer_top_k > 0 &&
@@ -2556,6 +2562,17 @@
                     hparams.ssm_n_group = hparams.n_head();
                 }
 
+                // Legacy 6block stores scalar head_count_kv=1 for every layer.
+                // Rebuild the GLM5NEXT pattern: every Nth layer is full MLA;
+                // all intervening layers are recurrent KDA (0 head_count_kv).
+                uint32_t full_attention_interval = 4;
+                ml.get_key(LLM_KV_FULL_ATTENTION_INTERVAL, full_attention_interval, false);
+                if (full_attention_interval == 0) {
+                    throw std::runtime_error("GLM5NEXT: full_attention_interval must be > 0");
+                }
+                for (uint32_t il = 0; il < hparams.n_layer; ++il) {
+                    hparams.n_head_kv_arr[il] = ((il + 1) % full_attention_interval == 0) ? 1 : 0;
+                }
+
                 // per-layer head_count_kv array: 0 marks the KDA (linear-attention) layers, 1 the MLA
                 for (uint32_t il = 0; il < hparams.n_layer; ++il) {
                     hparams.recurrent_layer_arr[il] = hparams.n_head_kv_arr[il] == 0;
