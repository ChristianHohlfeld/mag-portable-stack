diff --git a/tests/test-repack-cpu.cpp b/tests/test-repack-cpu.cpp
new file mode 100644
index 0000000..14af913
--- /dev/null
+++ b/tests/test-repack-cpu.cpp
@@ -0,0 +1,214 @@
+// test-repack-cpu: correctness + speed of the CPU repack (extra buffer) path against the plain CPU path.
+//
+// For each weight type / shape / batch size it builds  y = mul_mat(W, x)  twice:
+//   ref : W in the normal CPU buffer  -> ggml_vec_dot_* path
+//   rep : W in the CPU_REPACK buffer  -> ggml_gemv_* / ggml_gemm_* path (if the type is repacked on this CPU)
+// and reports NMSE between the two plus the time per evaluation.
+// MUL_MAT_ID (MoE experts) is covered with a small expert tensor and random routing.
+//
+// usage: test-repack-cpu [-t threads] [-r reps] [--quick]
+// exit code != 0 if any NMSE exceeds the tolerance.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static ggml_backend_buffer_type_t find_repack_buft() {
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto get_extra = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+    if (!get_extra) {
+        return nullptr;
+    }
+    for (ggml_backend_buffer_type_t * b = get_extra(dev); b && *b; ++b) {
+        if (strcmp(ggml_backend_buft_name(*b), "CPU_REPACK") == 0) {
+            return *b;
+        }
+    }
+    return nullptr;
+}
+
+struct result {
+    double nmse;
+    double ms_ref;
+    double ms_rep;
+    bool   repacked;
+};
+
+static void fill_uniform(std::vector<float> & v, std::mt19937 & rng, float lo = -1.0f, float hi = 1.0f) {
+    std::uniform_real_distribution<float> d(lo, hi);
+    for (auto & x : v) {
+        x = d(rng);
+    }
+}
+
+// one experiment: weights [K, N] (x E experts if E > 0), activations [K, B]
+static result run_case(ggml_backend_t backend, ggml_backend_buffer_type_t repack_buft, ggml_type wtype,
+                       int K, int N, int B, int E, int reps) {
+    std::mt19937 rng(1234 + K + N + B + E + (int) wtype);
+    const bool moe = E > 0;
+    const int  n_used = moe ? 2 : 0;
+
+    // ---- host data
+    std::vector<float> wf((size_t) K * N * (moe ? E : 1));
+    fill_uniform(wf, rng);
+    std::vector<uint8_t> wq(ggml_row_size(wtype, K) * (size_t) N * (moe ? E : 1));
+    ggml_quantize_chunk(wtype, wf.data(), wq.data(), 0, (int64_t) N * (moe ? E : 1), K, nullptr);
+
+    std::vector<float> xf((size_t) K * B * (moe ? n_used : 1));
+    fill_uniform(xf, rng);
+    std::vector<int32_t> ids;
+    if (moe) {
+        ids.resize((size_t) n_used * B);
+        std::uniform_int_distribution<int> de(0, E - 1);
+        for (int b = 0; b < B; ++b) {
+            int a = de(rng), c = de(rng);
+            while (c == a) c = de(rng);
+            ids[b * n_used + 0] = a;
+            ids[b * n_used + 1] = c;
+        }
+    }
+
+    auto build_and_run = [&](ggml_backend_buffer_type_t wbuft, std::vector<float> & out, double & ms, bool & extra_used) {
+        ggml_init_params ip = { ggml_tensor_overhead() * 16 + ggml_graph_overhead(), nullptr, true };
+        ggml_context * ctx_w = ggml_init(ip);
+        ggml_context * ctx   = ggml_init(ip);
+
+        ggml_tensor * w = moe ? ggml_new_tensor_3d(ctx_w, wtype, K, N, E) : ggml_new_tensor_2d(ctx_w, wtype, K, N);
+        ggml_backend_buffer_t wbuf = ggml_backend_alloc_ctx_tensors_from_buft(ctx_w, wbuft);
+        extra_used = w->extra != nullptr; // set by the repack buffer's init_tensor only if this type/shape is repacked
+        if (wbuft != ggml_backend_cpu_buffer_type() && !extra_used) {
+            // not repacked on this CPU: the repack buffer can't hold it -> plain buffer (same as llama.cpp's loader)
+            ggml_backend_buffer_free(wbuf);
+            ggml_free(ctx_w);
+            ctx_w = ggml_init(ip);
+            w = moe ? ggml_new_tensor_3d(ctx_w, wtype, K, N, E) : ggml_new_tensor_2d(ctx_w, wtype, K, N);
+            wbuf = ggml_backend_alloc_ctx_tensors_from_buft(ctx_w, ggml_backend_cpu_buffer_type());
+        }
+        ggml_backend_tensor_set(w, wq.data(), 0, wq.size()); // repack buffer repacks here
+
+        ggml_tensor * x;
+        ggml_tensor * y;
+        ggml_tensor * idt = nullptr;
+        if (moe) {
+            x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, K, n_used, B);
+            idt = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, B);
+            y   = ggml_mul_mat_id(ctx, w, x, idt);
+        } else {
+            x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, B);
+            y = ggml_mul_mat(ctx, w, x);
+        }
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, y);
+        ggml_backend_buffer_t abuf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        ggml_backend_tensor_set(x, xf.data(), 0, xf.size() * sizeof(float));
+        if (idt) {
+            ggml_backend_tensor_set(idt, ids.data(), 0, ids.size() * sizeof(int32_t));
+        }
+
+        ggml_backend_graph_compute(backend, gf); // warm-up
+        auto t0 = std::chrono::steady_clock::now();
+        for (int r = 0; r < reps; ++r) {
+            ggml_backend_graph_compute(backend, gf);
+        }
+        auto t1 = std::chrono::steady_clock::now();
+        ms = std::chrono::duration<double, std::milli>(t1 - t0).count() / reps;
+
+        out.resize(ggml_nelements(y));
+        ggml_backend_tensor_get(y, out.data(), 0, out.size() * sizeof(float));
+
+        ggml_backend_buffer_free(abuf);
+        ggml_backend_buffer_free(wbuf);
+        ggml_free(ctx);
+        ggml_free(ctx_w);
+    };
+
+    result r{};
+    std::vector<float> yref, yrep;
+    bool dummy = false;
+    build_and_run(ggml_backend_cpu_buffer_type(), yref, r.ms_ref, dummy);
+    build_and_run(repack_buft, yrep, r.ms_rep, r.repacked);
+
+    double num = 0, den = 0;
+    for (size_t i = 0; i < yref.size(); ++i) {
+        const double d = (double) yref[i] - yrep[i];
+        num += d * d;
+        den += (double) yref[i] * yref[i];
+    }
+    r.nmse = den > 0 ? num / den : num;
+    return r;
+}
+
+int main(int argc, char ** argv) {
+    int  n_threads = 1;
+    int  reps      = 20;
+    bool quick     = false;
+    for (int i = 1; i < argc; ++i) {
+        std::string a = argv[i];
+        if (a == "-t" && i + 1 < argc) {
+            n_threads = atoi(argv[++i]);
+        } else if (a == "-r" && i + 1 < argc) {
+            reps = atoi(argv[++i]);
+        } else if (a == "--quick") {
+            quick = true;
+        }
+    }
+
+    ggml_backend_load_all();
+    ggml_backend_t backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    ggml_backend_cpu_set_n_threads(backend, n_threads);
+    ggml_backend_buffer_type_t repack = find_repack_buft();
+    if (!repack) {
+        printf("no CPU_REPACK buffer type (built without GGML_CPU_REPACK?)\n");
+        return 1;
+    }
+
+    struct tcase { ggml_type t; int K, N, B, E; };
+    std::vector<tcase> cases;
+    const ggml_type types[] = { GGML_TYPE_Q8_0, GGML_TYPE_MXFP4, GGML_TYPE_Q4_0 };
+    const int batches_full[]  = { 1, 2, 3, 4, 5, 8, 16, 33 };
+    const int batches_quick[] = { 1, 4, 7 };
+    for (ggml_type t : types) {
+        // dense: hidden 4096 -> 4096, and a "wide" projection
+        for (int B : (quick ? std::vector<int>(std::begin(batches_quick), std::end(batches_quick))
+                            : std::vector<int>(std::begin(batches_full), std::end(batches_full)))) {
+            cases.push_back({ t, 4096, 4096, B, 0 });
+        }
+        if (!quick) {
+            cases.push_back({ t, 7168, 2048, 1, 0 });
+            cases.push_back({ t, 2048, 7168, 1, 0 });
+        }
+        // odd block count (K/32 = 65) and odd number of 4-row groups (N/4 = 257): tail paths
+        cases.push_back({ t, 2080, 1032, 1, 0 });
+        cases.push_back({ t, 2080, 1028, 1, 0 });
+        cases.push_back({ t, 2080, 1028, 6, 0 });
+        // MoE: 8 experts, 2 used per token
+        cases.push_back({ t, 2048, 1024, 1, 8 });
+        cases.push_back({ t, 2048, 1024, 9, 8 });
+    }
+
+    const double tol = 5e-4; // activations are q8_0-quantized on both paths; differences are summation order only
+    int failures = 0;
+    printf("%-6s %6s %6s %4s %3s | %10s | %9s %9s %7s | %s\n", "type", "K", "N", "B", "E", "nmse", "ref ms", "repack ms", "speedup", "path");
+    for (const auto & c : cases) {
+        result r = run_case(backend, repack, c.t, c.K, c.N, c.B, c.E, reps);
+        const bool ok = r.nmse < tol;
+        failures += ok ? 0 : 1;
+        printf("%-6s %6d %6d %4d %3d | %10.3e | %9.3f %9.3f %6.2fx | %s%s\n", ggml_type_name(c.t), c.K, c.N, c.B, c.E,
+               r.nmse, r.ms_ref, r.ms_rep, r.ms_ref / r.ms_rep, r.repacked ? "repack" : "plain (not repacked)",
+               ok ? "" : "  <-- FAIL");
+    }
+    ggml_backend_free(backend);
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "OK", failures, failures == 1 ? "" : "s");
+    return failures ? 1 : 0;
+}
