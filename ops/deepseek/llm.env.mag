# Safe bootstrap baseline based on the earlier isolated Q4 / parallel IQ3 setup.
# NEVER apply this over a live unit automatically. Host operators must
# benchmark before any Q4 restart. Node1 is reserved for IQ3 and backups.
ENGINE=ik
IK_BIN=/home/chris/.local/ik/8d21687cc7-mag-c96826ab/bin/llama-server
THREADS=16
THREADS_BATCH=16
BATCH=1024
UBATCH=1024
NUMA_ARGS="--cpunodebind=0 --membind=0"
LLAMA_NUMA=numactl
IK_RTR=1
IK_SLOT_SAVE=1
IK_SLOT_SAVE_PATH=/var/lib/mag-llm/slots
IK_CRS=0.20
LOAD_ARGS="--load-mode mmap+mlock"
