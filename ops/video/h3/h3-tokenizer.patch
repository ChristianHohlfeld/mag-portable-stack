+static const std::vector<std::string>& minimax_h3_special_tokens() {
+    // Qwen's own up to </think> (151643..151668), then H3's (151669..151675).
+    static const std::vector<std::string> tokens = [] {
+        std::vector<std::string> list(qwen2_special_tokens().begin(), qwen2_special_tokens().begin() + 26);
+        for (const char* token : {"<d>", "</d>", "<|cutoff|>", "<|lyrics_start|>", "<|lyrics_end|>", "<|caption_start|>", "<|caption_end|>"}) {
+            list.push_back(token);
+        }
+        return list;
+    }();
+    return tokens;
+}
+
+MiniMaxH3Tokenizer::MiniMaxH3Tokenizer()
+    : Qwen2Tokenizer("", minimax_h3_special_tokens()) {
+}
