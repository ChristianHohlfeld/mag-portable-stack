{
	auto_https off
	admin off
	servers {
		protocols h1 h2
	}
}

https://mag.stardenburg.de:443 {
	bind 100.123.114.16
	tls /etc/mag-caddy/tls/cert.pem /etc/mag-caddy/tls/key.pem
	# App shell, service worker and API stay fresh. Versioned /static files
	# keep the immutable Cache-Control magroom sets. flush_interval -1 so SSE
	# is not buffered.
	@nostore path / /index.html /sw.js /manifest.webmanifest /favicon.ico /favicon.svg /apple-touch-icon.png
	header @nostore Cache-Control "no-store"
	@api path /api/*
	header @api Cache-Control "no-store"
	reverse_proxy 127.0.0.1:8766 {
		flush_interval -1
	}
}
