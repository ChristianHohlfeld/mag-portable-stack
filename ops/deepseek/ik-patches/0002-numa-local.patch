+// mag: NUMA-lokaler Betrieb (MAG_NUMA_LOCAL=<threads>). Die iqk-Matmuls teilen die Zeilen jeder
+// Gewichtsmatrix statisch und zusammenhängend auf die Threads auf (Thread i -> Zeilenblock i).
+// Hier bekommt jeder Knoten einen zusammenhängenden Block von Threads (statt reihum), jeder Thread
+// eine feste CPU (physische Kerne zuerst); llama legt die Zeilenblöcke passend auf die Knoten
+// (mag_numa_place_weights). So liest jeder Kern seine Gewichte aus dem RAM des eigenen Sockels.
+static int mag_numa_local(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * s = getenv("MAG_NUMA_LOCAL");
+        v = (s && atoi(s) > 0) ? 1 : 0;
+    }
+    return v;
+}
+static uint32_t mag_cpu_order[GGML_NUMA_MAX_NODES][GGML_NUMA_MAX_CPUS];
+static pthread_once_t mag_cpu_order_once = PTHREAD_ONCE_INIT;
+static int mag_cpu_is_primary(uint32_t cpu) {
+    char path[160];
+    snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/topology/thread_siblings_list", cpu);
+    FILE * f = fopen(path, "r");
+    if (!f) return 1;
+    unsigned first = cpu;
+    const int ok = fscanf(f, "%u", &first);
+    fclose(f);
+    return ok != 1 || first == cpu;
+}
+static void mag_build_cpu_order(void) {
+    for (uint32_t n = 0; n < g_state.numa.n_nodes; ++n) {
+        const struct ggml_numa_node * node = &g_state.numa.nodes[n];
+        uint32_t k = 0;
+        for (int pass = 0; pass < 2; ++pass) {
+            for (uint32_t i = 0; i < node->n_cpus; ++i) {
+                const int prim = mag_cpu_is_primary(node->cpus[i]);
+                if ((pass == 0) == (prim != 0)) mag_cpu_order[n][k++] = node->cpus[i];
+            }
+        }
+    }
+}
+static int mag_set_numa_local_affinity(int thread_n, int n_threads) {
+    if (!mag_numa_local() || g_state.numa.numa_strategy != GGML_NUMA_STRATEGY_DISTRIBUTE || n_threads <= 0) {
+        return 0;
+    }
+    const int64_t N = g_state.numa.n_nodes;
+    const uint32_t node_num = (uint32_t)(((int64_t) thread_n * N) / n_threads);
+    const int64_t first = ((int64_t) node_num * n_threads + N - 1) / N; // erster Thread dieses Knotens
+    const struct ggml_numa_node * node = &g_state.numa.nodes[node_num];
+    if (node->n_cpus == 0) return 0;
+    pthread_once(&mag_cpu_order_once, mag_build_cpu_order);
+    const uint32_t cpu = mag_cpu_order[node_num][(uint32_t)(thread_n - first) % node->n_cpus];
+    const size_t setsize = CPU_ALLOC_SIZE(g_state.numa.total_cpus);
+    cpu_set_t * cpus = CPU_ALLOC(g_state.numa.total_cpus);
+    CPU_ZERO_S(setsize, cpus);
+    CPU_SET_S(cpu, setsize, cpus);
+    const int rv = pthread_setaffinity_np(pthread_self(), setsize, cpus);
+    if (rv) {
+        fprintf(stderr, "warning: pthread_setaffinity_np() failed: %s\n", strerror(rv));
+    }
+    CPU_FREE(cpus);
+    return 1;
+}
