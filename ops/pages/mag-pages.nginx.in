# Tailnet-only default. This file must NEVER bind 0.0.0.0, a public IP, or
# the Tailscale address. Clients reach 100.123.114.16:443; tailscaled forwards
# to this socket. The listen line matches the room vhost exactly.
# $mag_tailnet_ok comes from /etc/nginx/snippets/mag-tailnet-ok.inc (room
# http{} live; isolated tests include the repo file — do not include it here).
# Apex host is a private portal; wildcard hostnames serve published repos.
server {
    listen 127.0.0.1:4443 ssl http2 proxy_protocol;
    server_name @ZONE@;
    ssl_certificate /etc/mag-pages/tls/current/cert.pem;
    ssl_certificate_key /etc/mag-pages/tls/current/key.pem;
    # Funnel TCP shares :443. Public PROXY clients must not reach this vhost
    # via SNI or Host. real_ip + PROXY so allow/deny see the client, not
    # tailscaled's 127.0.0.1 connect.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    allow 100.64.0.0/10;
    allow fd7a:115c:a1e0::/48;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    if ($mag_tailnet_ok = 0) { return 403; }
    root /var/lib/mag-pages/portal;
    index index.html;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;
    location = /healthz { default_type text/plain; return 200 "ok\n"; }
    location = / { try_files /index.html =404; }
    location / { return 404; }
}

# MAG's native C++ process changes symlinks; nginx never reloads per commit.
server {
    listen 127.0.0.1:4443 ssl http2 proxy_protocol;
    server_name ~^(?<pageslug>[a-z0-9-]+)\.@ZONE_REGEX@$;
    ssl_certificate /etc/mag-pages/tls/current/cert.pem;
    ssl_certificate_key /etc/mag-pages/tls/current/key.pem;
    # Funnel TCP shares :443. Public PROXY clients must not reach this vhost
    # via SNI or Host. real_ip + PROXY so allow/deny see the client, not
    # tailscaled's 127.0.0.1 connect.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    allow 100.64.0.0/10;
    allow fd7a:115c:a1e0::/48;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    if ($mag_tailnet_ok = 0) { return 403; }
    root /var/lib/mag-pages/tailnet/$pageslug;
    index index.html;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    location ~ (^|/)\. { return 404; }
    location / { try_files $uri $uri/ =404; }
}
