# MAG Local LLM – DeepSeek-V4-Flash-0731 (unsloth UD-Q4_K_XL, ~155 GB) via llama.cpp, CPU-only.
# Installiert durch ops/deepseek/install-deepseek.sh nach /etc/systemd/system (Kopie, nicht Symlink).
# Vorher: GPT-OSS-120B (Git-Verlauf, ~/mag-infra/systemd/mag-llm.service.bak-gpt-oss).
#
# - Lauscht NUR intern auf 127.0.0.1:8090. Raum, Grok und Ali sprechen mit :8080 = mag-audit-gateway,
#   das jeden Aufruf vollständig protokolliert; :8090 ist per nftables nur für root/mag-audit offen.
# - Startet erst nach bestandener SHA-256-Vollprüfung: mag-model-gate.timer prüft nach dem Download,
#   schreibt den Freigabe-Stempel und startet die Unit. Vorher ist der Start ein No-op (Condition).
# - Flags gegen `llama serve --help` (build 11630) geprüft; install-deepseek.sh bricht bei unbekannten ab.
# - Warm halten: llama sperrt seine Seiten (mmap+mlock); zusätzlich hält mag-model-pin.service die
#   GGUF-Dateien unabhängig vom llama-Prozess gesperrt im Page-Cache. Ein Neustart von llama liest
#   dann aus dem RAM statt von der Platte. Hier deshalb KEIN drop_caches mehr.
#   Gewollter Neustart (z.B. neue Flags):  sudo bash ops/deepseek/warm.sh restart-llm
[Unit]
Description=MAG Local LLM - DeepSeek-V4-Flash-0731 via llama.cpp (CPU)
After=network-online.target mag-audit-nft.service mag-model-pin.service
Wants=network-online.target mag-model-pin.service
ConditionPathExists=/var/lib/mag-llm/verified.stamp
RefuseManualStop=yes

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris

ExecStartPre=/usr/local/lib/mag-deepseek/model-gate.sh check-stamp
ExecStartPre=/usr/bin/test -r /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja

# NUMA: Speicherrichtlinie "verschränkt" -> auch llamas eigene Puffer (umsortierte Gewichte, KV-Cache)
# liegen gleichmäßig auf beiden Sockeln; --numa distribute verteilt die Threads passend dazu.
ExecStart=/usr/bin/numactl --interleave=all /home/chris/.local/bin/llama serve \
  --model /home/chris/models/deepseek-v4/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf \
  --alias deepseek-v4-flash-0731 \
  --host 127.0.0.1 \
  --port 8090 \
  --ctx-size 32768 \
  --parallel 1 \
  --threads 28 \
  --threads-batch 28 \
  --numa distribute \
  --batch-size 1024 \
  --ubatch-size 1024 \
  --load-mode mmap+mlock \
  --cache-ram 8192 \
  --flash-attn auto \
  --jinja \
  --chat-template-file /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja \
  --reasoning-format deepseek \
  --temp 1.0 \
  --top-p 0.95 \
  --min-p 0.01 \
  --metrics \
  --no-webui

# immer wieder hochkommen (auch nach sauberem Ende); manuelles Stoppen ist gesperrt (RefuseManualStop)
Restart=always
RestartSec=10
# Laden von ~155 GB + mlock dauert Minuten (Type=simple: kein Start-Timeout nötig)
TimeoutStopSec=120

MemorySwapMax=0
MemoryLow=180G
OOMScoreAdjust=-1000
# systemd-oomd darf diese Unit nie als Opfer wählen
ManagedOOMPreference=omit
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
