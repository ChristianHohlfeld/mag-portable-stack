# /etc/default/mag-room (root:root 0600): the room's secrets and settings.
# ./install.sh writes this file once with a fresh VAPID key pair; fill in the rest.
# Web search for the bots (Brave Search API key; empty = no web_search).
MAG_ROOM_BRAVE_KEY=
# Web Push to Chris's phone (generated by ./install.sh; keep them stable or the
# phone has to subscribe again). Their contact is MAG_CONTACT in /etc/mag-stack/host.env.
MAG_ROOM_VAPID_PUBLIC=
MAG_ROOM_VAPID_PRIVATE=
