# Independent, parallel DeepSeek IQ3 on NUMA node 1; Q4 remains node0.
[Unit]
Description=MAG DeepSeek IQ3 parallel CPU instance, NUMA node 1
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/chris/models/deepseek-v4-UD-IQ3_XXS/SHA256SUMS
StartLimitIntervalSec=1800
StartLimitBurst=2
[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris
Environment=MAG_IQ3_DIR=/home/chris/models/deepseek-v4-UD-IQ3_XXS
ExecStartPre=/usr/local/lib/mag-deepseek/verify-iq3.sh
ExecStart=/usr/local/lib/mag-deepseek/start-iq3.sh
Restart=on-failure
RestartSec=60
TimeoutStartSec=10800
TimeoutStopSec=120
CPUAffinity=14-25 42-53
NUMAPolicy=bind
NUMAMask=1
MemoryAccounting=yes
MemoryHigh=155G
MemoryMax=176G
MemorySwapMax=0
LimitMEMLOCK=infinity
OOMScoreAdjust=-600
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/mag-llm/slots/iq3
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
# Intentionally no [Install] section: Ali starts once after independent preflight.
