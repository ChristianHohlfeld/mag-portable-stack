# Central model interface with a complete, hash-chained audit log. The room
# talks to :8080 only; the gateway forwards to lena :8191 and noah :8192.
# Model units are never started or stopped by this unit.
[Unit]
Description=MAG audit gateway (central LLM interface, full audit log)
After=network.target
Before=mag-120.service

[Service]
Type=simple
User=mag-audit
Group=mag-audit
SupplementaryGroups=magbot
UMask=0027
Environment=MAG_AUDIT_LISTEN_HOST=127.0.0.1
Environment=MAG_AUDIT_LISTEN_PORT=8080
Environment=MAG_AUDIT_UPSTREAM_HOST=127.0.0.1
# Two single-slot model servers; the room names the bot (X-Mag-Slot 0/1).
Environment=MAG_ROOM_MODEL_ID=lena
Environment=MAG_ROOM_MODEL_PORTS=8191:0,8192:1
Environment=MAG_ROOM_MAX_BOTS=2
Environment=MAG_ROOM_MODEL_ID_0=lena
Environment=MAG_ROOM_MODEL_ID_1=noah
Environment="MAG_ROOM_MODEL_LABEL_0=Lena (Gemma 4)"
Environment="MAG_ROOM_MODEL_LABEL_1=Noah (gpt-oss)"
Environment=MAG_AUDIT_LOG_DIR=/var/log/mag-audit
Environment=MAG_AUDIT_SECRETS_FILE=/etc/mag-audit/secrets.list
ExecStart=/opt/mag-audit/bin/mag-audit-gateway
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=mag-audit
ReadWritePaths=/var/log/mag-audit /var/lib/mag-audit
ReadOnlyPaths=/etc/mag-audit /opt/mag-audit
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target

