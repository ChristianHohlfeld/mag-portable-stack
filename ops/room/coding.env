# Two CPU MoE room bots, one per NUMA node (owner decision 2026-11-02):
# NUMA0 Qwen3.8-Flash-Next (existing IQ4_XS GGUF), NUMA1 Qwen3-Coder-Next UD-Q4_K_XL.
# Chat-only like the GLM room (no tool schemas); long answers continue on
# finish_reason=length until the model stops (see magroom.cpp long_reply_model).
MAG_ROOM_MODEL_ID=qwen3.8-flash-next
MAG_ROOM_MODEL_LABEL="Qwen3.8 + Qwen3-Coder-Next"
MAG_ROOM_MODEL_PORTS=8191:0,8192:1
MAG_ROOM_MAX_BOTS=2
MAG_ROOM_SINGLE_BOT=
MAG_ROOM_THINKING=off
MAG_ROOM_PRESETS=/opt/mag-stack/current/ops/room/presets.json
MAG_ROOM_PREWARM=1
MAG_ROOM_PREFIX_DISK=1
MAG_ROOM_SLOTS=1
MAG_ROOM_MODEL_ID_0=qwen3.8-flash-next
MAG_ROOM_MODEL_LABEL_0="Qwen3.8"
MAG_ROOM_MODEL_ID_1=qwen3-coder-next
MAG_ROOM_MODEL_LABEL_1="Qwen3-Coder-Next"
