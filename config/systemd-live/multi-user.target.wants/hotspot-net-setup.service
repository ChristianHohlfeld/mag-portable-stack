[Unit]
Description=Prepare isolated hotspot interface
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/ip link set wlx2023516593f0 down
ExecStart=/usr/sbin/ip addr flush dev wlx2023516593f0
ExecStart=/usr/sbin/ip link set wlx2023516593f0 up
ExecStart=/usr/sbin/ip addr add 10.77.0.1/24 dev wlx2023516593f0
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
