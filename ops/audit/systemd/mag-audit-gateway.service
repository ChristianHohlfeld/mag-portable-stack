# Zentrale LLM-Schnittstelle mit vollständigem Audit-Log (installiert von ops/audit/install-audit.sh;
# Programm liegt rollback-stabil unter /opt/mag-audit, nicht im Raum-Release).
# Clients -> 127.0.0.1:8080 (hier) -> 127.0.0.1:8090 (mag-llm / llama serve)
[Unit]
Description=MAG audit gateway (central LLM interface, full audit log)
After=network.target
Before=mag-120.service

[Service]
Type=simple
User=mag-audit
Group=mag-audit
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=MAG_AUDIT_LISTEN_HOST=127.0.0.1
Environment=MAG_AUDIT_LISTEN_PORT=8080
Environment=MAG_AUDIT_UPSTREAM_HOST=127.0.0.1
Environment=MAG_AUDIT_UPSTREAM_PORT=8090
Environment=MAG_AUDIT_UPSTREAM_TIMEOUT=7200
Environment=MAG_AUDIT_LOG_DIR=/var/log/mag-audit
Environment=MAG_AUDIT_SECRETS_FILE=/etc/mag-audit/secrets.list
ExecStart=/usr/bin/python3 -I /opt/mag-audit/mag_audit_gateway.py
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/mag-audit
ReadOnlyPaths=/etc/mag-audit /opt/mag-audit
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
