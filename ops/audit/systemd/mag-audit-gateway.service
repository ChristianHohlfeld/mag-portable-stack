# Zentrale LLM-Schnittstelle mit vollständigem Audit-Log (installiert von ops/audit/install-audit.sh;
# Programm liegt rollback-stabil unter /opt/mag-audit, nicht im Raum-Release).
# Clients -> C++ gateway :8080 -> Ornith :8191/:8192; Qwen :8091 on rollback.
# Model units are never restarted by this unit.
[Unit]
Description=MAG audit gateway (central LLM interface, full audit log)
After=network.target
Before=mag-120.service

[Service]
Type=simple
User=mag-audit
Group=mag-audit
SupplementaryGroups=magbot
UMask=0027
Environment=MAG_AUDIT_LISTEN_HOST=127.0.0.1
Environment=MAG_AUDIT_LISTEN_PORT=8080
Environment=MAG_AUDIT_UPSTREAM_HOST=127.0.0.1
Environment=MAG_MODEL_IQ3_PORT=8091
Environment=MAG_MODEL_ORNITH_PORTS=8191:0,8192:0,8191:1,8192:1
# Installed only during an explicit operator cutover. Absent => existing IQ3.
EnvironmentFile=-/etc/mag-stack/secondary-model.env
Environment=MAG_AUDIT_LOG_DIR=/var/log/mag-audit
Environment=MAG_AUDIT_SECRETS_FILE=/etc/mag-audit/secrets.list
ExecStart=/opt/mag-audit/bin/mag-audit-gateway
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=mag-audit
ReadWritePaths=/var/log/mag-audit /var/lib/mag-audit
ReadOnlyPaths=/etc/mag-audit /opt/mag-audit
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
