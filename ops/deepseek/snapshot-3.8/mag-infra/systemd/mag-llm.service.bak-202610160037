# MAG Local LLM – DeepSeek-V4-Flash-0731 (unsloth UD-Q4_K_XL, ~155 GB) via llama.cpp, CPU-only.
# Installiert durch ops/deepseek/install-deepseek.sh nach /etc/systemd/system (Kopie, nicht Symlink).
#
# PERSISTENCE (Chris): Model must NEVER be unloaded — reload takes ~30+ min.
# - Restart=always, RefuseManualStop=yes, OOMScoreAdjust=-1000, LimitMEMLOCK=infinity
# - No PartOf/BindsTo to mag-120/audit; deploy/rollout must not restart this unit unless ExecStart flags change
# - No idle/sleep unload; --load-mode mmap+mlock keeps weights resident
# - Do NOT drop_caches on start (keeps page cache / vmtouch warm)
#
# - Listen 127.0.0.1:8090 only; clients use :8080 mag-audit-gateway
# - Starts after SHA-256 gate stamp (ConditionPathExists)
[Unit]
Description=MAG Local LLM - DeepSeek-V4-Flash-0731 via llama.cpp (CPU)
After=network-online.target mag-audit-nft.service
Wants=network-online.target
ConditionPathExists=/var/lib/mag-llm/verified.stamp
# Block accidental systemctl stop/restart (use systemctl kill only in emergencies)
RefuseManualStop=yes

[Service]
Type=simple
User=chris
Group=chris
WorkingDirectory=/home/chris

ExecStartPre=/usr/local/lib/mag-deepseek/model-gate.sh check-stamp
ExecStartPre=/usr/bin/test -r /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja
# NOTE: deliberately NO drop_caches here — unloading page cache forces a cold mlock next time.

ExecStart=/home/chris/.local/bin/llama serve \
  --model /home/chris/models/deepseek-v4/DeepSeek-V4-Flash-0731-UD-Q4_K_XL-00001-of-00005.gguf \
  --alias deepseek-v4-flash-0731 \
  --host 127.0.0.1 \
  --port 8090 \
  --ctx-size 32768 \
  --parallel 1 \
  --threads 28 \
  --threads-batch 56 \
  --numa distribute \
  --batch-size 1024 \
  --ubatch-size 1024 \
  --load-mode mmap+mlock \
  --cache-ram 8192 \
  --flash-attn auto \
  --jinja \
  --chat-template-file /home/chris/llama-templates/deepseek-ai-DeepSeek-V4-Flash-0731.jinja \
  --reasoning-format deepseek \
  --temp 1.0 \
  --top-p 0.95 \
  --min-p 0.01 \
  --metrics \
  --no-webui

# Always come back after crash/OOM/kill; never stay down
Restart=always
RestartSec=5
# Loading 155GB+mlock takes many minutes — no start timeout (Type=simple)
TimeoutStartSec=infinity
TimeoutStopSec=180

MemorySwapMax=0
MemoryLow=180G
OOMScoreAdjust=-1000
LimitNOFILE=1048576
LimitMEMLOCK=infinity
# Prefer staying alive under memory pressure
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
